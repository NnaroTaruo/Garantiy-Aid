 });
+
+test("production development-mode and incomplete SMS configuration fail closed", async () => {
+  const saved = { mode: env.mobileAuthMode, node: env.nodeEnv, key: env.mobileSmsSemaphoreApiKey, secret: env.mobileAuthSecret };
+  const server = app.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  try {
+    for (const scenario of ["production-development", "missing-sms-key", "missing-auth-secret"]) {
+      env.mobileAuthMode = scenario === "production-development" ? "DEVELOPMENT" : "SMS";
+      env.nodeEnv = scenario === "production-development" ? "production" : "test";
+      env.mobileSmsSemaphoreApiKey = scenario === "missing-sms-key" ? undefined : "synthetic-sms-key-only";
+      env.mobileAuthSecret = scenario === "missing-auth-secret" ? undefined : "synthetic-auth-key-only-32-characters";
+      const response = await fetch(`http://127.0.0.1:${server.address().port}/api/v1/mobile/auth/otp/request`, {
+        method: "POST", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ contactNumber: "09171234567", purpose: "login" }),
+      });
+      assert.equal(response.status, 503);
+      const payload = await response.json();
+      assert.equal(payload.error.code, "MOBILE_AUTH_UNAVAILABLE");
+      assert.equal("developmentOtp" in (payload.data ?? {}), false);
+    }
+  } finally {
+    env.mobileAuthMode = saved.mode; env.nodeEnv = saved.node;
+    env.mobileSmsSemaphoreApiKey = saved.key; env.mobileAuthSecret = saved.secret;
+    await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+  }
+});
