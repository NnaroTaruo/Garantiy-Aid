+import test from "node:test";
+import assert from "node:assert/strict";
+import { randomInt, randomUUID } from "node:crypto";
+import { once } from "node:events";
+
+test("SMS auth hides codes, confirms gateway acceptance, invalidates failed deliveries and separates development credentials", {
+  skip: process.env.RUN_MOBILE_DB_TESTS !== "1",
+}, async () => {
+  assert.ok(process.env.DATABASE_URL, "Explicitly select a separate migrated test database.");
+  process.env.AUTH_RATE_LIMIT_PER_15_MINUTES = "100";
+  const [{ default: app }, { default: prisma }, { env }] = await Promise.all([
+    import("../src/app.js"), import("../src/lib/prisma.js"), import("../src/config/env.js"),
+  ]);
+  const savedMode = env.mobileAuthMode, savedKey = env.mobileSmsSemaphoreApiKey;
+  const nativeFetch = globalThis.fetch;
+  env.mobileAuthMode = "SMS"; env.mobileSmsSemaphoreApiKey = "synthetic-sms-key-only";
+  const server = app.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const base = `http://127.0.0.1:${server.address().port}/api/v1/mobile`;
+  const request = (route, body, token) => nativeFetch(base + route, { method: body ? "POST" : "GET",
+    headers: { "Content-Type": "application/json", ...(token ? { Authorization: `Bearer ${token}` } : {}) },
+    ...(body ? { body: JSON.stringify(body) } : {}) });
+  const barangayId = randomUUID(), owners = [];
+  const phone = () => `+639${randomInt(100_000_000, 1_000_000_000)}`;
+  let scenario = "hold", release, started;
+  const reachedGateway = new Promise(resolve => { started = resolve; });
+  const held = new Promise(resolve => { release = resolve; });
+  const delivered = [];
+  globalThis.fetch = async (url, options) => {
+    assert.equal(url, "https://api.semaphore.co/api/v4/messages", "No unmocked SMS network request is permitted");
+    const code = options.body.get("message").match(/code: (\d{6})\./)[1];
+    delivered.push({ code, number: options.body.get("number") });
+    started();
+    if (scenario === "hold") await held;
+    if (scenario === "failure") throw new Error("Synthetic private provider failure");
+    return Response.json([{ message_id: delivered.length, recipient: options.body.get("number"),
+      message: options.body.get("message"), status: "Queued" }]);
+  };
+  const coolDown = accountId => prisma.beneficiaryMobileOtp.updateMany({ where: { accountId }, data: { createdAt: new Date(Date.now() - 61_000) } });
+  try {
+    await prisma.barangay.create({ data: { barangayId, barangayCode: barangayId.slice(0, 20), barangayName: "Synthetic SMS auth test", city: "Test", province: "Test" } });
+    const input = { firstName: "Synthetic", lastName: "SMS", middleName: "", birthDate: "1990-01-01", sex: "female", address: "Synthetic SMS test address", barangayId, contactNumber: phone() };
+    const registering = request("/auth/register", input);
+    await reachedGateway;
+    const pending = await prisma.beneficiaryMobileAccount.findUniqueOrThrow({ where: { contactNumber: input.contactNumber } });
+    owners.push(pending.beneficiaryId);
+    const challenge = await prisma.beneficiaryMobileOtp.findFirstOrThrow({ where: { accountId: pending.accountId } });
+    assert.equal(challenge.deliveryMode, "SMS");
+    assert.equal(challenge.deliveryAcceptedAt, null);
+    assert.notEqual(challenge.codeHash, delivered[0].code);
+    const premature = await request("/auth/otp/verify", { contactNumber: input.contactNumber, purpose: "register", code: delivered[0].code });
+    assert.equal(premature.status, 409);
+    assert.equal((await premature.json()).error.code, "OTP_NOT_READY");
+    release(); scenario = "success";
+    const registration = await registering;
+    assert.equal(registration.status, 201);
+    const registered = (await registration.json()).data;
+    assert.deepEqual(Object.keys(registered).sort(), ["beneficiary", "expiresInSeconds", "verificationRequired"]);
+    const verified = await request("/auth/otp/verify", { contactNumber: input.contactNumber, purpose: "register", code: delivered[0].code });
+    assert.equal(verified.status, 200);
+    const session = (await verified.json()).data;
+    assert.equal(session.beneficiary.isVerified, false);
+    assert.equal(session.beneficiary.phoneVerified, true);
+    assert.equal((await prisma.beneficiaryMobileSession.findFirstOrThrow({ where: { accountId: pending.accountId } })).authMode, "SMS");
+    env.mobileAuthMode = "DEVELOPMENT";
+    assert.equal((await request("/beneficiaries/me", null, session.accessToken)).status, 401);
+    await coolDown(pending.accountId);
+    const development = (await (await request("/auth/otp/request", { contactNumber: input.contactNumber, purpose: "login" })).json()).data;
+    assert.match(development.developmentOtp, /^\d{6}$/);
+    env.mobileAuthMode = "SMS";
+    const wrongMode = await request("/auth/otp/verify", { contactNumber: input.contactNumber, purpose: "login", code: development.developmentOtp });
+    assert.equal(wrongMode.status, 400);
+    env.mobileAuthMode = "DEVELOPMENT";
+    const devLogin = (await (await request("/auth/otp/verify", { contactNumber: input.contactNumber, purpose: "login", code: development.developmentOtp })).json()).data;
+    env.mobileAuthMode = "SMS";
+    assert.equal((await request("/beneficiaries/me", null, devLogin.accessToken)).status, 401);
+    assert.equal((await request("/beneficiaries/me", null, session.accessToken)).status, 200);
+    await coolDown(pending.accountId);
+    scenario = "failure";
+    const failed = await request("/auth/otp/request", { contactNumber: input.contactNumber, purpose: "login" });
+    assert.equal(failed.status, 503);
+    assert.equal((await failed.json()).error.code, "OTP_DELIVERY_FAILED");
+    const failedChallenge = await prisma.beneficiaryMobileOtp.findFirstOrThrow({ where: { accountId: pending.accountId }, orderBy: { createdAt: "desc" } });
+    assert.ok(failedChallenge.consumedAt);
+    assert.equal(failedChallenge.deliveryAcceptedAt, null);
+    assert.equal((await request("/auth/otp/verify", { contactNumber: input.contactNumber, purpose: "login", code: delivered.at(-1).code })).status, 400);
+    assert.equal((await request("/auth/otp/request", { contactNumber: input.contactNumber, purpose: "login" })).status, 429);
+    await coolDown(pending.accountId);
+    scenario = "success";
+    const retry = await request("/auth/otp/request", { contactNumber: input.contactNumber, purpose: "login" });
+    assert.equal(retry.status, 202);
+    assert.deepEqual(Object.keys((await retry.json()).data), ["expiresInSeconds"]);
+    const recovered = await request("/auth/otp/verify", { contactNumber: input.contactNumber, purpose: "login", code: delivered.at(-1).code });
+    assert.equal(recovered.status, 200);
+    assert.equal((await recovered.json()).data.beneficiary.id, pending.beneficiaryId);
+    assert.equal((await request("/auth/otp/verify", { contactNumber: input.contactNumber, purpose: "login", code: delivered.at(-1).code })).status, 400);
+    scenario = "failure";
+    const second = { ...input, lastName: "Retry", contactNumber: phone() };
+    assert.equal((await request("/auth/register", second)).status, 503);
+    const unfinished = await prisma.beneficiaryMobileAccount.findUniqueOrThrow({ where: { contactNumber: second.contactNumber } });
+    owners.push(unfinished.beneficiaryId);
+    assert.equal(unfinished.verifiedAt, null);
+    await coolDown(unfinished.accountId);
+    scenario = "success";
+    assert.equal((await request("/auth/otp/request", { contactNumber: second.contactNumber, purpose: "register" })).status, 202);
+    assert.equal((await request("/auth/otp/verify", { contactNumber: second.contactNumber, purpose: "register", code: delivered.at(-1).code })).status, 200);
+    assert.equal(await prisma.beneficiary.count({ where: { beneficiaryId: { in: owners } } }), 2);
+  } finally {
+    release();
+    globalThis.fetch = nativeFetch; env.mobileAuthMode = savedMode; env.mobileSmsSemaphoreApiKey = savedKey;
+    await new Promise((resolve, reject) => server.close(error => error ? reject(error) : resolve()));
+    await prisma.auditLog.deleteMany({ where: { actorType: "BENEFICIARY", recordId: { in: owners } } });
+    await prisma.beneficiary.deleteMany({ where: { beneficiaryId: { in: owners } } });
+    await prisma.barangay.deleteMany({ where: { barangayId } });
+    await prisma.$disconnect();
+  }
+});
diff --git a/test/mobile-sms.test.js b/test/mobile-sms.test.js
new file mode 100644
index 0000000..8d852ac
--- /dev/null
+++ b/test/mobile-sms.test.js
@@ -0,0 +1,79 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { env } from "../src/config/env.js";
+import { sendMobileOtpSms } from "../src/modules/mobile/mobileSms.service.js";
+
+const phone = "+639171234567", code = "001234";
+async function withGateway(run) {
+  const originalFetch = globalThis.fetch;
+  const saved = { mode: env.mobileAuthMode, key: env.mobileSmsSemaphoreApiKey, sender: env.mobileSmsSenderName, timeout: env.mobileSmsTimeoutMs };
+  env.mobileAuthMode = "SMS"; env.mobileSmsSemaphoreApiKey = "synthetic-sms-key-only";
+  env.mobileSmsSenderName = undefined; env.mobileSmsTimeoutMs = 1000;
+  try { await run(); } finally {
+    globalThis.fetch = originalFetch;
+    env.mobileAuthMode = saved.mode; env.mobileSmsSemaphoreApiKey = saved.key;
+    env.mobileSmsSenderName = saved.sender; env.mobileSmsTimeoutMs = saved.timeout;
+  }
+}
+const accepted = body => ({ message_id: 123, recipient: body.get("number"), message: body.get("message"), status: "Pending" });
+
+test("SMS delivery uses one HTTPS recipient, a short private code and the account's configured sender", () => withGateway(async () => {
+  let calls = 0;
+  globalThis.fetch = async (url, options) => {
+    calls++;
+    assert.equal(url, "https://api.semaphore.co/api/v4/messages");
+    assert.equal(options.redirect, "error");
+    assert.equal(options.method, "POST");
+    assert.equal(options.body.get("number"), phone.slice(1));
+    assert.equal(options.body.get("apikey"), env.mobileSmsSemaphoreApiKey);
+    assert.ok(options.body.get("message").includes(code));
+    assert.ok(options.body.get("message").length <= 160);
+    assert.equal(options.body.has("sendername"), calls !== 1);
+    return Response.json([accepted(options.body)]);
+  };
+  assert.equal(await sendMobileOtpSms(phone, code), undefined, "Do not return the raw gateway response");
+  env.mobileSmsSenderName = "Approved";
+  await sendMobileOtpSms(phone, code);
+  assert.equal(calls, 2);
+}));
+
+test("SMS failures, malformed replies and wrong recipients return a sanitized delivery error without retry", () => withGateway(async () => {
+  for (const scenario of ["http", "network", "json", "empty", "failed", "refunded", "foreign", "missing-code"]) {
+    let calls = 0;
+    globalThis.fetch = async (_url, options) => {
+      calls++;
+      if (scenario === "network") throw new Error(`Private ${code} ${env.mobileSmsSemaphoreApiKey}`);
+      if (scenario === "http") return Response.json({ private: code }, { status: 429 });
+      if (scenario === "json") return new Response("not json");
+      const row = accepted(options.body);
+      if (["failed", "refunded"].includes(scenario)) row.status = scenario;
+      if (scenario === "foreign") row.recipient = "639999999999";
+      if (scenario === "missing-code") row.message = "Unexpected message";
+      return Response.json(scenario === "empty" ? [] : [row]);
+    };
+    await assert.rejects(sendMobileOtpSms(phone, code), error => error.code === "OTP_DELIVERY_FAILED"
+      && error.statusCode === 503 && !error.message.includes(code) && !error.message.includes(env.mobileSmsSemaphoreApiKey));
+    assert.equal(calls, 1);
+  }
+}));
+
+test("SMS refuses disabled/unconfigured modes and malformed internal recipient/code values", () => withGateway(async () => {
+  globalThis.fetch = () => { throw new Error("Must not contact a gateway"); };
+  env.mobileAuthMode = "DEVELOPMENT";
+  await assert.rejects(sendMobileOtpSms(phone, code), { code: "MOBILE_AUTH_UNAVAILABLE" });
+  env.mobileAuthMode = "SMS"; env.mobileSmsSemaphoreApiKey = undefined;
+  await assert.rejects(sendMobileOtpSms(phone, code), { code: "MOBILE_AUTH_UNAVAILABLE" });
+  env.mobileSmsSemaphoreApiKey = "synthetic-sms-key-only";
+  for (const [recipient, value] of [[phone + ",639999999999", code], [phone, "abc123"], ["+14155552671", code]]) {
+    await assert.rejects(sendMobileOtpSms(recipient, value), /Invalid internal OTP/);
+  }
+}));
+
+test("SMS requests abort at their configured deadline", () => withGateway(async () => {
+  env.mobileSmsTimeoutMs = 5;
+  globalThis.fetch = async (_url, options) => new Promise((_resolve, reject) => {
+    const timer = setTimeout(() => reject(new Error("Deadline was not applied")), 100);
+    options.signal.addEventListener("abort", () => { clearTimeout(timer); reject(options.signal.reason); }, { once: true });
+  });
+  await assert.rejects(sendMobileOtpSms(phone, code), { code: "OTP_DELIVERY_FAILED" });
+}));
