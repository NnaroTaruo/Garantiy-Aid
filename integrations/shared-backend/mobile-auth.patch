@@ -0,0 +1,25 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { once } from "node:events";
+import app from "../src/app.js";
+import { env } from "../src/config/env.js";
+
+test("disabled mobile authentication fails closed without exposing a development code", async () => {
+  const previousMode = env.mobileAuthMode;
+  env.mobileAuthMode = "DISABLED";
+  const server = app.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  try {
+    const response = await fetch(`http://127.0.0.1:${server.address().port}/api/v1/mobile/auth/otp/request`, {
+      method: "POST", headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ contactNumber: "09171234567", purpose: "login" }),
+    });
+    const body = await response.json();
+    assert.equal(response.status, 503);
+    assert.equal(body.error.code, "MOBILE_AUTH_UNAVAILABLE");
+    assert.equal("developmentOtp" in (body.data ?? {}), false);
+  } finally {
+    env.mobileAuthMode = previousMode;
+    await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+  }
+});
diff --git a/test/mobile.schemas.test.js b/test/mobile.schemas.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..facceed18204f0417342dddf8f0cea746ebc722c
--- /dev/null
+++ b/test/mobile.schemas.test.js
@@ -0,0 +1,25 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mobileOtpRequestSchema, mobileProfileSchema, mobileRegistrationSchema } from "../src/modules/mobile/mobile.schemas.js";
+
+test("mobile input normalizes phone/name values and rejects protected fields and invalid dates", () => {
+  const input = {
+    firstName: "  María-José ", middleName: " ", lastName: "D’Cruz", birthDate: "1990-04-23",
+    sex: "Prefer not to say", address: "12 Test Street", barangayId: "62f95c7d-68e7-4c3a-9ced-7fef670b8a3a", contactNumber: "9171234567",
+  };
+  const result = mobileRegistrationSchema.parse(input);
+  assert.equal(result.firstName, "María-José");
+  assert.equal(result.middleName, null);
+  assert.equal(result.sex, "UNKNOWN");
+  assert.equal(result.contactNumber, "+639171234567");
+  for (const contactNumber of ["0917 123 4567", "+63 917 123 4567", "639171234567"]) {
+    assert.equal(mobileOtpRequestSchema.parse({ contactNumber, purpose: "login" }).contactNumber, result.contactNumber);
+  }
+  for (const change of [{ firstName: "123" }, { birthDate: "2026-02-31" }, { birthDate: "2999-01-01" }, { status: "ACTIVE" }, { isVerified: true }, { contactNumber: null }]) {
+    assert.equal(mobileRegistrationSchema.safeParse({ ...input, ...change }).success, false);
+  }
+  assert.deepEqual(mobileProfileSchema.parse({ middleName: " " }), { middleName: null });
+  for (const value of [{}, { beneficiaryId: input.barangayId }, { contactNumber: input.contactNumber }, { isVerified: true }, { status: "ACTIVE" }]) {
+    assert.equal(mobileProfileSchema.safeParse(value).success, false);
+  }
+});
