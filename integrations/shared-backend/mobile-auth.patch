+++ b/test/mobile-auth.integration.js
@@ -0,0 +1,128 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { randomInt, randomUUID } from "node:crypto";
+import { once } from "node:events";
+
+// Explicit opt-in: this suite creates/removes its own fixtures in a migrated test database.
+test("mobile registration is visible to staff, OTPs are single-use, and sessions remain isolated", {
+  skip: process.env.RUN_MOBILE_DB_TESTS !== "1",
+}, async () => {
+  const [{ default: app }, { default: prisma }, { signAccessToken }] = await Promise.all([
+    import("../src/app.js"), import("../src/lib/prisma.js"), import("../src/modules/auth/auth.service.js"),
+  ]);
+  const server = app.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const base = `http://127.0.0.1:${server.address().port}/api/v1`;
+  const marker = randomUUID();
+  const barangayId = randomUUID();
+  const inactiveId = randomUUID();
+  const userId = randomUUID();
+  const staffSessionId = randomUUID();
+  const ids = [];
+  const phone = () => `+639${randomInt(100_000_000, 1_000_000_000)}`;
+  const request = (path, { token, body, method = body ? "POST" : "GET", origin } = {}) => fetch(base + path, {
+    method, headers: { ...(token ? { Authorization: `Bearer ${token}` } : {}), ...(body ? { "Content-Type": "application/json" } : {}), ...(origin ? { Origin: origin } : {}) },
+    ...(body ? { body: JSON.stringify(body) } : {}),
+  });
+  const otp = (contactNumber, purpose, code) => request("/mobile/auth/otp/verify", { body: { contactNumber, purpose, code } });
+  const coolDown = (accountId) => prisma.beneficiaryMobileOtp.updateMany({ where: { accountId }, data: { createdAt: new Date(Date.now() - 61_000) } });
+  try {
+    for (const [id, active] of [[barangayId, true], [inactiveId, false]]) await prisma.barangay.create({ data: {
+      barangayId: id, barangayCode: id.slice(0, 20), barangayName: "Mobile integration test", city: "Test", province: "Test", isActive: active,
+    } });
+    await prisma.user.create({ data: { userId, employeeId: marker.slice(0, 20), username: `test_${marker.replaceAll("-", "").slice(0, 16)}`, fullName: "Mobile test staff", email: `${marker}@example.invalid`, passwordHash: "test-only-not-a-login-password", role: "SYSTEM_ADMIN" } });
+    await prisma.staffSession.create({ data: { sessionId: staffSessionId, userId, expiresAt: new Date(Date.now() + 300_000) } });
+    const staffToken = signAccessToken({ userId, role: "SYSTEM_ADMIN" }, { jwtId: staffSessionId });
+    const input = { firstName: "Mobile", middleName: "", lastName: "Integration", birthDate: "1990-01-01", sex: "female", address: "12 Synthetic Street", barangayId, contactNumber: phone() };
+    const areaResponse = await request("/mobile/barangays", { origin: "http://127.0.0.1:8765" });
+    assert.equal(areaResponse.headers.get("Access-Control-Allow-Origin"), "http://127.0.0.1:8765");
+    const areas = (await areaResponse.json()).data;
+    assert.ok(areas.some((area) => area.id === barangayId));
+    assert.ok(!areas.some((area) => area.id === inactiveId));
+    assert.equal((await request("/mobile/auth/register", { body: { ...input, isVerified: true } })).status, 400);
+    assert.equal((await request("/mobile/auth/register", { body: { ...input, barangayId: inactiveId } })).status, 422);
+    const registration = await request("/mobile/auth/register", { body: input });
+    assert.equal(registration.status, 201);
+    const registered = (await registration.json()).data;
+    ids.push(registered.beneficiary.id);
+    assert.match(registered.developmentOtp, /^\d{6}$/);
+    assert.equal(registered.beneficiary.isVerified, false);
+    assert.equal(registered.beneficiary.phoneVerified, false);
+    assert.equal(registered.beneficiary.contactNumber, input.contactNumber);
+    assert.equal((await request("/mobile/auth/register", { body: input })).status, 409);
+    assert.equal((await request("/mobile/auth/otp/request", { body: { contactNumber: input.contactNumber, purpose: "login" } })).status, 403);
+    assert.equal((await request("/mobile/auth/otp/request", { body: { contactNumber: input.contactNumber, purpose: "register" } })).status, 429);
+    const account = await prisma.beneficiaryMobileAccount.findUnique({ where: { beneficiaryId: ids[0] } });
+    const challenges = await prisma.beneficiaryMobileOtp.findMany({ where: { accountId: account.accountId } });
+    assert.notEqual(challenges[0].codeHash, registered.developmentOtp);
+    const incorrect = registered.developmentOtp === "000000" ? "999999" : "000000";
+    assert.equal((await otp(input.contactNumber, "register", incorrect)).status, 400);
+    assert.equal((await prisma.beneficiaryMobileOtp.findUnique({ where: { challengeId: challenges[0].challengeId } })).attemptsRemaining, 4);
+    const results = await Promise.all([otp(input.contactNumber, "register", registered.developmentOtp), otp(input.contactNumber, "register", registered.developmentOtp)]);
+    assert.deepEqual(results.map((response) => response.status).sort(), [200, 409]);
+    const login = (await results.find((response) => response.status === 200).json()).data;
+    assert.equal(login.beneficiary.phoneVerified, true);
+    assert.equal(login.beneficiary.isVerified, false); // Phone access must not approve identity or eligibility.
+    assert.equal(await prisma.enrollment.count({ where: { beneficiaryId: ids[0] } }), 0);
+    const session = await prisma.beneficiaryMobileSession.findFirst({ where: { accountId: account.accountId } });
+    assert.notEqual(session.tokenHash, login.accessToken);
+    assert.equal((await request("/mobile/beneficiaries/me")).status, 401);
+    assert.equal((await request("/mobile/beneficiaries/me", { token: staffToken })).status, 401);
+    assert.equal((await request("/beneficiaries", { token: login.accessToken })).status, 401);
+    const staffRecord = await request(`/beneficiaries/${ids[0]}`, { token: staffToken });
+    assert.equal(staffRecord.status, 200);
+    assert.equal((await staffRecord.json()).data.beneficiary.contactNumber, input.contactNumber);
+    const staffList = await request(`/beneficiaries?barangayId=${barangayId}`, { token: staffToken });
+    assert.ok((await staffList.json()).data.beneficiaries.some((person) => person.beneficiaryId === ids[0]));
+    const profile = (await (await request("/mobile/beneficiaries/me", { token: login.accessToken })).json()).data;
+    assert.equal(profile.id, ids[0]);
+    for (const key of ["passwordHash", "philsysNumber", "accountId", "tokenHash"]) assert.equal(key in profile, false);
+    for (const body of [{ status: "ACTIVE" }, { isVerified: true }, { beneficiaryId: randomUUID() }, { contactNumber: phone() }]) {
+      assert.equal((await request("/mobile/beneficiaries/me", { method: "PATCH", token: login.accessToken, body })).status, 400);
+    }
+    const update = await request("/mobile/beneficiaries/me", { method: "PATCH", token: login.accessToken, body: { address: "  24 Updated Street  ", middleName: " " } });
+    assert.equal(update.status, 200);
+    assert.equal((await update.json()).data.address, "24 Updated Street");
+    assert.equal((await (await request(`/beneficiaries/${ids[0]}`, { token: staffToken })).json()).data.beneficiary.address, "24 Updated Street");
+    await coolDown(account.accountId);
+    const loginChallenge = (await (await request("/mobile/auth/otp/request", { body: { contactNumber: input.contactNumber, purpose: "login" } })).json()).data;
+    const signedInAgain = (await (await otp(input.contactNumber, "login", loginChallenge.developmentOtp)).json()).data;
+    assert.equal(signedInAgain.beneficiary.address, "24 Updated Street");
+    assert.equal((await request("/mobile/auth/logout", { token: login.accessToken, body: {} })).status, 204);
+    assert.equal((await request("/mobile/beneficiaries/me", { token: login.accessToken })).status, 401);
+    assert.equal((await request("/mobile/beneficiaries/me", { token: signedInAgain.accessToken })).status, 200);
+
+    const secondInput = { ...input, lastName: "Other", contactNumber: phone() };
+    const second = (await (await request("/mobile/auth/register", { body: secondInput })).json()).data;
+    ids.push(second.beneficiary.id);
+    const otherToken = (await (await otp(secondInput.contactNumber, "register", second.developmentOtp)).json()).data.accessToken;
+    assert.equal((await (await request("/mobile/beneficiaries/me", { token: otherToken })).json()).data.id, ids[1]);
+    assert.equal((await request(`/mobile/beneficiaries/${ids[0]}`, { token: otherToken })).status, 404);
+    const blocked = await request("/mobile/auth/register", { body: { ...input, contactNumber: phone() } });
+    assert.equal(blocked.status, 409);
+    assert.equal((await blocked.json()).error.code, "ACCOUNT_LINK_REQUIRED");
+    await prisma.beneficiary.update({ where: { beneficiaryId: ids[0] }, data: { status: "SUSPENDED" } });
+    assert.equal((await request("/mobile/beneficiaries/me", { token: signedInAgain.accessToken })).status, 401);
+    assert.equal((await request("/mobile/auth/otp/request", { body: { contactNumber: input.contactNumber, purpose: "login" } })).status, 403);
+    const otherAccount = await prisma.beneficiaryMobileAccount.findUnique({ where: { beneficiaryId: ids[1] } });
+    await coolDown(otherAccount.accountId);
+    const expiring = (await (await request("/mobile/auth/otp/request", { body: { contactNumber: secondInput.contactNumber, purpose: "login" } })).json()).data;
+    await prisma.beneficiaryMobileOtp.updateMany({ where: { accountId: otherAccount.accountId, consumedAt: null }, data: { expiresAt: new Date(Date.now() - 1) } });
+    assert.equal((await otp(secondInput.contactNumber, "login", expiring.developmentOtp)).status, 400);
+    await coolDown(otherAccount.accountId);
+    const limited = (await (await request("/mobile/auth/otp/request", { body: { contactNumber: secondInput.contactNumber, purpose: "login" } })).json()).data;
+    const wrong = limited.developmentOtp === "000000" ? "999999" : "000000";
+    const failures = await Promise.all(Array.from({ length: 5 }, () => otp(secondInput.contactNumber, "login", wrong)));
+    assert.ok(failures.every((response) => response.status === 400));
+    assert.equal((await otp(secondInput.contactNumber, "login", limited.developmentOtp)).status, 429);
+    await prisma.beneficiaryMobileSession.updateMany({ where: { account: { beneficiaryId: ids[1] } }, data: { expiresAt: new Date(Date.now() - 1) } });
+    assert.equal((await request("/mobile/beneficiaries/me", { token: otherToken })).status, 401);
+  } finally {
+    await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+    await prisma.auditLog.deleteMany({ where: { recordId: { in: ids }, actorType: "BENEFICIARY" } });
+    await prisma.beneficiary.deleteMany({ where: { beneficiaryId: { in: ids } } });
+    await prisma.user.deleteMany({ where: { userId } });
+    await prisma.barangay.deleteMany({ where: { barangayId: { in: [barangayId, inactiveId] } } });
+    await prisma.$disconnect();
+  }
+});
diff --git a/test/mobile.configuration.test.js b/test/mobile.configuration.test.js
