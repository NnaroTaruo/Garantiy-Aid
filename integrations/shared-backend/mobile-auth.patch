diff --git a/src/modules/mobile/mobile.routes.js b/src/modules/mobile/mobile.routes.js
new file mode 100644
index 0000000000000000000000000000000000000000..9635d98896501be399fa6da5d0b76a76764b785d
--- /dev/null
+++ b/src/modules/mobile/mobile.routes.js
@@ -0,0 +1,44 @@
+import { Router } from "express";
+import prisma from "../../lib/prisma.js";
+import { asyncHandler } from "../../utils/asyncHandler.js";
+import { validateBody } from "../../middleware/validate.js";
+import { mobileAuthenticationRateLimiter } from "../../middleware/rateLimit.js";
+import { mobileOtpRequestSchema, mobileOtpVerificationSchema, mobileProfileSchema, mobileRegistrationSchema } from "./mobile.schemas.js";
+import { authenticateMobile, logoutMobile, mobileProfile, registerMobile, requestMobileOtp, updateMobileProfile, verifyMobileOtp } from "./mobile.service.js";
+
+const mobileRoutes = Router();
+
+mobileRoutes.get("/barangays", asyncHandler(async (_req, res) => {
+  const barangays = await prisma.barangay.findMany({
+    where: { isActive: true }, orderBy: [{ city: "asc" }, { barangayName: "asc" }],
+    select: { barangayId: true, barangayCode: true, barangayName: true, city: true, province: true },
+  });
+  res.json({ success: true, data: barangays.map(({ barangayId, ...area }) => ({ id: barangayId, ...area })) });
+}));
+
+mobileRoutes.post("/auth/register", mobileAuthenticationRateLimiter, validateBody(mobileRegistrationSchema), asyncHandler(async (req, res) => {
+  res.status(201).json({ success: true, data: await registerMobile(req.validatedBody) });
+}));
+mobileRoutes.post("/auth/otp/request", mobileAuthenticationRateLimiter, validateBody(mobileOtpRequestSchema), asyncHandler(async (req, res) => {
+  res.status(202).json({ success: true, data: await requestMobileOtp(req.validatedBody) });
+}));
+mobileRoutes.post("/auth/otp/verify", mobileAuthenticationRateLimiter, validateBody(mobileOtpVerificationSchema), asyncHandler(async (req, res) => {
+  res.json({ success: true, data: await verifyMobileOtp(req.validatedBody) });
+}));
+
+mobileRoutes.use(asyncHandler(async (req, _res, next) => {
+  req.mobileSession = await authenticateMobile(req.get("authorization"));
+  next();
+}));
+mobileRoutes.get("/beneficiaries/me", (req, res) => {
+  res.json({ success: true, data: mobileProfile(req.mobileSession.account) });
+});
+mobileRoutes.patch("/beneficiaries/me", validateBody(mobileProfileSchema), asyncHandler(async (req, res) => {
+  res.json({ success: true, data: await updateMobileProfile(req.mobileSession, req.validatedBody) });
+}));
+mobileRoutes.post("/auth/logout", asyncHandler(async (req, res) => {
+  await logoutMobile(req.mobileSession);
+  res.sendStatus(204);
+}));
+
+export default mobileRoutes;
diff --git a/src/modules/mobile/mobile.schemas.js b/src/modules/mobile/mobile.schemas.js
new file mode 100644
index 0000000000000000000000000000000000000000..4e7f15540e0a69a00a2c125682adc94a2c993fee
--- /dev/null
+++ b/src/modules/mobile/mobile.schemas.js
@@ -0,0 +1,32 @@
+import { z } from "zod";
+import { optionalPhilippineMobileSchema } from "../../lib/philippine-mobile.js";
+import { createBeneficiarySchema } from "../beneficiaries/beneficiary.schemas.js";
+
+const name = z.string().trim().min(1).max(100)
+  .regex(/^[\p{L}\p{M} .'’-]+$/u, "Use letters and normal name punctuation only.")
+  .refine((value) => /\p{L}/u.test(value), "Enter a name containing letters.");
+const middleName = z.preprocess(
+  (value) => typeof value === "string" && !value.trim() ? null : value,
+  name.nullable().optional(),
+);
+const address = z.string().trim().min(5).max(500);
+const barangayId = z.uuid();
+const contactNumber = z.preprocess((value) => {
+  if (typeof value !== "string") return value;
+  const compact = value.trim().replace(/[\s()-]/g, "");
+  return /^9\d{9}$/.test(compact) ? `+63${compact}` : /^639\d{9}$/.test(compact) ? `+${compact}` : compact;
+}, optionalPhilippineMobileSchema().pipe(z.string()));
+const purpose = z.enum(["register", "login"]);
+
+export const mobileRegistrationSchema = createBeneficiarySchema.pick({ birthDate: true }).extend({
+  firstName: name, middleName, lastName: name, address, barangayId, contactNumber,
+  sex: z.preprocess(
+    (value) => typeof value === "string" ? value.trim().toLowerCase().replaceAll(" ", "_") : value,
+    z.enum(["female", "male", "prefer_not_to_say"]),
+  ).transform((value) => ({ female: "FEMALE", male: "MALE", prefer_not_to_say: "UNKNOWN" })[value]),
+}).strict();
+
+export const mobileOtpRequestSchema = z.object({ contactNumber, purpose }).strict();
+export const mobileOtpVerificationSchema = mobileOtpRequestSchema.extend({ code: z.string().regex(/^\d{6}$/) }).strict();
+export const mobileProfileSchema = z.object({ firstName: name, middleName, lastName: name, address, barangayId })
+  .partial().strict().refine((value) => Object.keys(value).length > 0, "Supply a name, address, or barangay change.");
