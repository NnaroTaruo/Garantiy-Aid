+// Mobile phone ownership is separate from staff identity/eligibility verification.
+model BeneficiaryMobileAccount {
+  accountId     String    @id @default(uuid()) @map("account_id") @db.Uuid
+  beneficiaryId String    @unique @map("beneficiary_id") @db.Uuid
+  contactNumber String    @unique @map("contact_number") @db.VarChar(20)
+  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
+  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
+  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
+
+  beneficiary Beneficiary            @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)
+  challenges  BeneficiaryMobileOtp[]
+  sessions    BeneficiaryMobileSession[]
+
+  @@map("beneficiary_mobile_accounts")
+}
+
+model BeneficiaryMobileOtp {
+  challengeId       String    @id @default(uuid()) @map("challenge_id") @db.Uuid
+  accountId         String    @map("account_id") @db.Uuid
+  purpose           String    @db.VarChar(10)
+  codeHash          String    @map("code_hash") @db.Char(64)
+  attemptsRemaining Int       @default(5) @map("attempts_remaining")
+  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
+  consumedAt        DateTime? @map("consumed_at") @db.Timestamptz(6)
+  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
+
+  account BeneficiaryMobileAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
+
+  @@index([accountId, createdAt])
+  @@map("beneficiary_mobile_otps")
+}
+
+model BeneficiaryMobileSession {
+  sessionId String    @id @default(uuid()) @map("session_id") @db.Uuid
+  accountId String    @map("account_id") @db.Uuid
+  tokenHash String    @unique @map("token_hash") @db.Char(64)
+  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
+  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
+  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
+
+  account BeneficiaryMobileAccount @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
+
+  @@index([accountId, expiresAt])
+  @@map("beneficiary_mobile_sessions")
+}
+
