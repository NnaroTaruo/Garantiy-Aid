diff --git a/src/modules/mobile/mobile.routes.js b/src/modules/mobile/mobile.routes.js
new file mode 100644
index 0000000000000000000000000000000000000000..f7c63fe01063ba74f6c60dbeda7f651f266f79bc
--- /dev/null
+++ b/src/modules/mobile/mobile.routes.js
@@ -0,0 +1,59 @@
+import { Router } from "express";
+import prisma from "../../lib/prisma.js";
+import { asyncHandler } from "../../utils/asyncHandler.js";
+import { validateBody, validateParams } from "../../middleware/validate.js";
+import { uploadBeneficiaryDocument } from "../documents/beneficiaryDocument.upload.js";
+import { beneficiaryDocumentParamsSchema } from "../documents/beneficiaryDocument.schemas.js";
+import { downloadMobileDocument, listMobileDocuments, uploadMobileDocument } from "./mobileDocuments.controller.js";
+import { getMobileOverview } from "./mobileOverview.service.js";
+import { issueMobileClaimPass } from "./mobileClaimPass.service.js";
+import { mobileAuthenticationRateLimiter } from "../../middleware/rateLimit.js";
+import { mobileOtpRequestSchema, mobileOtpVerificationSchema, mobileProfileSchema, mobileRegistrationSchema } from "./mobile.schemas.js";
+import { authenticateMobile, logoutMobile, mobileProfile, registerMobile, requestMobileOtp, updateMobileProfile, verifyMobileOtp } from "./mobile.service.js";
+
+const mobileRoutes = Router();
+
+mobileRoutes.get("/barangays", asyncHandler(async (_req, res) => {
+  const barangays = await prisma.barangay.findMany({
+    where: { isActive: true }, orderBy: [{ city: "asc" }, { barangayName: "asc" }],
+    select: { barangayId: true, barangayCode: true, barangayName: true, city: true, province: true },
+  });
+  res.json({ success: true, data: barangays.map(({ barangayId, ...area }) => ({ id: barangayId, ...area })) });
+}));
+
+mobileRoutes.post("/auth/register", mobileAuthenticationRateLimiter, validateBody(mobileRegistrationSchema), asyncHandler(async (req, res) => {
+  res.status(201).json({ success: true, data: await registerMobile(req.validatedBody) });
+}));
+mobileRoutes.post("/auth/otp/request", mobileAuthenticationRateLimiter, validateBody(mobileOtpRequestSchema), asyncHandler(async (req, res) => {
+  res.status(202).json({ success: true, data: await requestMobileOtp(req.validatedBody) });
+}));
+mobileRoutes.post("/auth/otp/verify", mobileAuthenticationRateLimiter, validateBody(mobileOtpVerificationSchema), asyncHandler(async (req, res) => {
+  res.json({ success: true, data: await verifyMobileOtp(req.validatedBody) });
+}));
+
+mobileRoutes.use(asyncHandler(async (req, _res, next) => {
+  req.mobileSession = await authenticateMobile(req.get("authorization"));
+  next();
+}));
+mobileRoutes.get("/beneficiaries/me", (req, res) => {
+  res.json({ success: true, data: mobileProfile(req.mobileSession.account) });
+});
+mobileRoutes.get("/beneficiaries/me/overview", asyncHandler(async (req, res) => {
+  res.set("Cache-Control", "private, no-store").json({ success: true, data: await getMobileOverview(req.mobileSession) });
+}));
+mobileRoutes.post("/beneficiaries/me/claim-pass", mobileAuthenticationRateLimiter, asyncHandler(async (req, res) => {
+  res.set("Cache-Control", "private, no-store").json({ success: true, data: await issueMobileClaimPass(req.mobileSession) });
+}));
+mobileRoutes.get("/beneficiaries/me/documents", listMobileDocuments);
+mobileRoutes.post("/beneficiaries/me/documents", uploadBeneficiaryDocument, uploadMobileDocument);
+mobileRoutes.post("/beneficiaries/me/documents/:documentId/replacement", validateParams(beneficiaryDocumentParamsSchema.pick({ documentId: true })), uploadBeneficiaryDocument, uploadMobileDocument);
+mobileRoutes.get("/beneficiaries/me/documents/:documentId/content", validateParams(beneficiaryDocumentParamsSchema.pick({ documentId: true })), downloadMobileDocument);
+mobileRoutes.patch("/beneficiaries/me", validateBody(mobileProfileSchema), asyncHandler(async (req, res) => {
+  res.json({ success: true, data: await updateMobileProfile(req.mobileSession, req.validatedBody) });
+}));
+mobileRoutes.post("/auth/logout", asyncHandler(async (req, res) => {
+  await logoutMobile(req.mobileSession);
+  res.sendStatus(204);
+}));
+
+export default mobileRoutes;
diff --git a/src/modules/mobile/mobile.schemas.js b/src/modules/mobile/mobile.schemas.js
new file mode 100644
index 0000000000000000000000000000000000000000..4e7f15540e0a69a00a2c125682adc94a2c993fee
--- /dev/null
+++ b/src/modules/mobile/mobile.schemas.js
@@ -0,0 +1,32 @@
+import { z } from "zod";
+import { optionalPhilippineMobileSchema } from "../../lib/philippine-mobile.js";
+import { createBeneficiarySchema } from "../beneficiaries/beneficiary.schemas.js";
+
+const name = z.string().trim().min(1).max(100)
+  .regex(/^[\p{L}\p{M} .'’-]+$/u, "Use letters and normal name punctuation only.")
+  .refine((value) => /\p{L}/u.test(value), "Enter a name containing letters.");
+const middleName = z.preprocess(
+  (value) => typeof value === "string" && !value.trim() ? null : value,
+  name.nullable().optional(),
+);
+const address = z.string().trim().min(5).max(500);
+const barangayId = z.uuid();
+const contactNumber = z.preprocess((value) => {
+  if (typeof value !== "string") return value;
+  const compact = value.trim().replace(/[\s()-]/g, "");
+  return /^9\d{9}$/.test(compact) ? `+63${compact}` : /^639\d{9}$/.test(compact) ? `+${compact}` : compact;
+}, optionalPhilippineMobileSchema().pipe(z.string()));
+const purpose = z.enum(["register", "login"]);
+
+export const mobileRegistrationSchema = createBeneficiarySchema.pick({ birthDate: true }).extend({
+  firstName: name, middleName, lastName: name, address, barangayId, contactNumber,
+  sex: z.preprocess(
+    (value) => typeof value === "string" ? value.trim().toLowerCase().replaceAll(" ", "_") : value,
+    z.enum(["female", "male", "prefer_not_to_say"]),
+  ).transform((value) => ({ female: "FEMALE", male: "MALE", prefer_not_to_say: "UNKNOWN" })[value]),
+}).strict();
+
+export const mobileOtpRequestSchema = z.object({ contactNumber, purpose }).strict();
+export const mobileOtpVerificationSchema = mobileOtpRequestSchema.extend({ code: z.string().regex(/^\d{6}$/) }).strict();
+export const mobileProfileSchema = z.object({ firstName: name, middleName, lastName: name, address, barangayId })
+  .partial().strict().refine((value) => Object.keys(value).length > 0, "Supply a name, address, or barangay change.");
diff --git a/src/modules/mobile/mobile.service.js b/src/modules/mobile/mobile.service.js
new file mode 100644
index 0000000000000000000000000000000000000000..cfdbeb82f40b7164bfa7bee5241b61d0835dc5b6
--- /dev/null
+++ b/src/modules/mobile/mobile.service.js
@@ -0,0 +1,192 @@
+import { createHmac, randomBytes, randomInt, randomUUID, timingSafeEqual } from "node:crypto";
+import prisma from "../../lib/prisma.js";
+import { env } from "../../config/env.js";
+import { AppError } from "../../utils/AppError.js";
+
+const OTP_LIFETIME_MS = 5 * 60_000;
+const RESEND_WAIT_MS = 60_000;
+const SESSION_LIFETIME_MS = 7 * 24 * 60 * 60_000;
+
+function requireMobileAuth() {
+  if (env.mobileAuthMode !== "DEVELOPMENT" || !env.mobileAuthSecret || env.nodeEnv === "production") {
+    throw new AppError(503, "MOBILE_AUTH_UNAVAILABLE", "Beneficiary authentication is not enabled. Development OTP must be configured; real SMS delivery is not connected.");
+  }
+}
+
+export function hashMobileSecret(value) {
+  requireMobileAuth();
+  return createHmac("sha256", env.mobileAuthSecret).update(value).digest("hex");
+}
+
+export function mobileProfile(account) {
+  const person = account.beneficiary;
+  return {
+    id: person.beneficiaryId,
+    firstName: person.firstName, middleName: person.middleName, lastName: person.lastName,
+    birthDate: person.birthDate.toISOString().slice(0, 10),
+    sex: ({ FEMALE: "female", MALE: "male", UNKNOWN: "prefer_not_to_say", OTHER: "prefer_not_to_say" })[person.sex] ?? "prefer_not_to_say",
+    address: person.address, barangayId: person.barangayId,
+    contactNumber: account.contactNumber,
+    isVerified: person.isVerified, phoneVerified: Boolean(account.verifiedAt),
+    status: person.status.toLowerCase(),
+  };
+}
+
+function assertActive(account) {
+  if (account.beneficiary.status !== "ACTIVE") throw new AppError(403, "ACCOUNT_INACTIVE", "This beneficiary account is inactive. Contact your barangay facilitator.");
+}
+
+async function activeBarangay(database, barangayId) {
+  if (!await database.barangay.findFirst({ where: { barangayId, isActive: true }, select: { barangayId: true } })) {
+    throw new AppError(422, "INVALID_BARANGAY", "Select an active barangay.", { fields: [{ field: "barangayId", message: "Select an active barangay." }] });
+  }
+}
+
+async function audit(database, account, action) {
+  await database.auditLog.create({ data: {
+    actorType: "BENEFICIARY", action, entityAffected: "BENEFICIARY", recordId: account.beneficiaryId,
+    details: { source: "MOBILE_APP" },
+  } });
+}
+
+// Serialize OTP issue/verification for one account, including across API instances.
+async function lockedAccount(database, accountId) {
+  await database.$queryRaw`SELECT account_id FROM beneficiary_mobile_accounts WHERE account_id = ${accountId}::uuid FOR UPDATE`;
+  return database.beneficiaryMobileAccount.findUniqueOrThrow({ where: { accountId }, include: { beneficiary: true } });
+}
+
+async function createChallenge(database, accountId, purpose) {
+  const now = new Date();
+  const recent = await database.beneficiaryMobileOtp.findFirst({
+    where: { accountId, createdAt: { gt: new Date(now.getTime() - RESEND_WAIT_MS) } },
+  });
+  if (recent) throw new AppError(429, "OTP_TOO_SOON", "Wait one minute before requesting another code.");
+  await database.beneficiaryMobileOtp.updateMany({ where: { accountId, consumedAt: null }, data: { consumedAt: now } });
+  const challengeId = randomUUID();
+  const code = randomInt(0, 1_000_000).toString().padStart(6, "0");
+  await database.beneficiaryMobileOtp.create({ data: {
+    challengeId, accountId, purpose, codeHash: hashMobileSecret(`otp:${challengeId}:${code}`),
+    expiresAt: new Date(now.getTime() + OTP_LIFETIME_MS),
+  } });
+  // Explicit development mode only; never log the code or send it to an SMS queue.
+  return { expiresInSeconds: OTP_LIFETIME_MS / 1000, developmentOtp: code };
+}
+
+export async function registerMobile(input) {
+  requireMobileAuth();
+  try {
+    return await prisma.$transaction(async (tx) => {
+      if (await tx.beneficiaryMobileAccount.findUnique({ where: { contactNumber: input.contactNumber } })) {
+        throw new AppError(409, "PHONE_ALREADY_REGISTERED", "This mobile number already has an account.");
+      }
+      await activeBarangay(tx, input.barangayId);
+      const nationalPhone = `0${input.contactNumber.slice(3)}`;
+      const existing = await tx.beneficiary.findFirst({ where: { OR: [
+        { contactNumber: { in: [input.contactNumber, nationalPhone, input.contactNumber.slice(1), input.contactNumber.slice(3)] } },
+        { firstName: { equals: input.firstName, mode: "insensitive" }, lastName: { equals: input.lastName, mode: "insensitive" }, birthDate: input.birthDate, barangayId: input.barangayId },
+      ] }, select: { beneficiaryId: true } });
+      // A shared contact number or matching identity is not proof of ownership of a staff record.
+      if (existing) throw new AppError(409, "ACCOUNT_LINK_REQUIRED", "A matching beneficiary record already exists. Sign in with its registered mobile number, or contact your barangay facilitator to link a staff-managed record.");
+      const beneficiary = await tx.beneficiary.create({ data: { ...input, middleName: input.middleName ?? null } });
+      const account = await tx.beneficiaryMobileAccount.create({ data: {
+        beneficiaryId: beneficiary.beneficiaryId, contactNumber: input.contactNumber,
+      }, include: { beneficiary: true } });
+      const otp = await createChallenge(tx, account.accountId, "register");
+      await audit(tx, account, "MOBILE_ACCOUNT_REGISTERED");
+      return { beneficiary: mobileProfile(account), verificationRequired: true, ...otp };
+    });
+  } catch (error) {
+    if (error.code === "P2002") throw new AppError(409, "PHONE_ALREADY_REGISTERED", "This mobile number already has an account.");
+    throw error;
+  }
+}
+
+async function findAccount(contactNumber) {
+  requireMobileAuth();
+  const account = await prisma.beneficiaryMobileAccount.findUnique({ where: { contactNumber }, select: { accountId: true } });
+  if (!account) throw new AppError(404, "ACCOUNT_NOT_FOUND", "No mobile account uses this number. Register or contact your barangay facilitator.");
+  return account;
+}
+
+function assertPurpose(account, purpose) {
+  assertActive(account);
+  if (purpose === "login" && !account.verifiedAt) throw new AppError(403, "ACCOUNT_NOT_VERIFIED", "Verify your phone before signing in.");
+  if (purpose === "register" && account.verifiedAt) throw new AppError(409, "ACCOUNT_ALREADY_VERIFIED", "This account is already verified. Sign in instead.");
+}
+
+export async function requestMobileOtp({ contactNumber, purpose }) {
+  const { accountId } = await findAccount(contactNumber);
+  return prisma.$transaction(async (tx) => {
+    const account = await lockedAccount(tx, accountId);
+    assertPurpose(account, purpose);
+    return createChallenge(tx, accountId, purpose);
+  });
+}
+
+export async function verifyMobileOtp({ contactNumber, purpose, code }) {
+  const { accountId } = await findAccount(contactNumber);
+  const result = await prisma.$transaction(async (tx) => {
+    const account = await lockedAccount(tx, accountId);
+    assertPurpose(account, purpose);
+    const challenge = await tx.beneficiaryMobileOtp.findFirst({ where: { accountId, purpose, consumedAt: null }, orderBy: { createdAt: "desc" } });
+    if (!challenge || challenge.expiresAt <= new Date()) throw new AppError(400, "OTP_EXPIRED", "This code has expired. Request a new one.");
+    if (challenge.attemptsRemaining <= 0) throw new AppError(429, "OTP_ATTEMPTS_EXCEEDED", "Request a new code and try again.");
+    const candidate = Buffer.from(hashMobileSecret(`otp:${challenge.challengeId}:${code}`), "hex");
+    const stored = Buffer.from(challenge.codeHash, "hex");
+    if (candidate.length !== stored.length || !timingSafeEqual(candidate, stored)) {
+      await tx.beneficiaryMobileOtp.update({ where: { challengeId: challenge.challengeId }, data: { attemptsRemaining: { decrement: 1 } } });
+      // Return then throw after commit so the failed attempt is not rolled back.
+      return { error: true };
+    }
+    const now = new Date();
+    await tx.beneficiaryMobileOtp.update({ where: { challengeId: challenge.challengeId }, data: { consumedAt: now } });
+    if (purpose === "register") account.verifiedAt = (await tx.beneficiaryMobileAccount.update({ where: { accountId }, data: { verifiedAt: now } })).verifiedAt;
+    const token = `gya_mobile_${randomBytes(32).toString("base64url")}`;
+    const expiresAt = new Date(now.getTime() + SESSION_LIFETIME_MS);
+    await tx.beneficiaryMobileSession.create({ data: { accountId, tokenHash: hashMobileSecret(`session:${token}`), expiresAt } });
+    await audit(tx, account, "MOBILE_PHONE_AUTHENTICATED");
+    return { accessToken: token, tokenType: "Bearer", expiresAt: expiresAt.toISOString(), beneficiary: mobileProfile(account) };
+  });
+  if (result.error) throw new AppError(400, "OTP_INCORRECT", "The verification code is incorrect.");
+  return result;
+}
+
+export async function authenticateMobile(authorization) {
+  const match = /^Bearer (gya_mobile_[A-Za-z0-9_-]{43})$/.exec(authorization ?? "");
+  if (!match) throw new AppError(401, "AUTHENTICATION_REQUIRED", "A beneficiary access token is required.");
+  const session = await prisma.beneficiaryMobileSession.findUnique({
+    where: { tokenHash: hashMobileSecret(`session:${match[1]}`) },
+    include: { account: { include: { beneficiary: true } } },
+  });
+  if (!session || session.revokedAt || session.expiresAt <= new Date() || !session.account.verifiedAt || session.account.beneficiary.status !== "ACTIVE") {
+    throw new AppError(401, "SESSION_EXPIRED", "Your beneficiary session has expired or the account is inactive. Sign in again.");
+  }
+  return session;
+}
+
+export async function updateMobileProfile(session, input) {
+  return prisma.$transaction(async (tx) => {
+    const account = await lockMobileSession(tx, session);
+    if (input.barangayId && input.barangayId !== account.beneficiary.barangayId) await activeBarangay(tx, input.barangayId);
+    account.beneficiary = await tx.beneficiary.update({ where: { beneficiaryId: account.beneficiaryId }, data: input });
+    await audit(tx, account, "MOBILE_PROFILE_UPDATED");
+    return mobileProfile(account);
+  });
+}
+
+export async function lockMobileSession(database, session) {
+  const account = await lockedAccount(database, session.accountId);
+  const current = await database.beneficiaryMobileSession.findUnique({ where: { sessionId: session.sessionId } });
+  if (!current || current.revokedAt || current.expiresAt <= new Date() || !account.verifiedAt || account.beneficiary.status !== "ACTIVE") {
+    throw new AppError(401, "SESSION_EXPIRED", "Sign in again before saving.");
+  }
+  return account;
+}
+
+export async function logoutMobile(session) {
+  await prisma.$transaction(async (tx) => {
+    const account = await lockedAccount(tx, session.accountId);
+    await tx.beneficiaryMobileSession.update({ where: { sessionId: session.sessionId }, data: { revokedAt: new Date() } });
+    await audit(tx, account, "MOBILE_SESSION_REVOKED");
+  });
+}
diff --git a/src/modules/mobile/mobileClaimPass.service.js b/src/modules/mobile/mobileClaimPass.service.js
new file mode 100644
index 0000000000000000000000000000000000000000..7f0e322d679a64cddb058117f7ff262dbb6d5f10
--- /dev/null
+++ b/src/modules/mobile/mobileClaimPass.service.js
@@ -0,0 +1,71 @@
+import { randomUUID } from "node:crypto";
+import prisma from "../../lib/prisma.js";
+import { AppError } from "../../utils/AppError.js";
+import { hashQrToken, assertQrVerificationConfigured, qrClaimPreviewOutcome } from "../distributions/distributionClaim.service.js";
+import { getMobileOverview } from "./mobileOverview.service.js";
+import { hashMobileSecret, lockMobileSession } from "./mobile.service.js";
+
+// A domain-separated HMAC lets the owner reopen a mobile-issued credential;
+// only its SHA-256 hash is stored, using the existing staff scanner's format.
+function mobileQrCredential(qrTokenId) {
+  return `gya1_${Buffer.from(hashMobileSecret(`qr-claim-pass:v1:${qrTokenId}`), "hex").toString("base64url")}`;
+}
+
+export async function issueMobileClaimPass(session) {
+  try {
+    return await prisma.$transaction(async (tx) => {
+      const account = await lockMobileSession(tx, session);
+      const { nextSchedule: schedule } = await getMobileOverview(session, tx);
+      if (!schedule) throw new AppError(404, "CLAIM_PASS_UNAVAILABLE", "No eligible published schedule is assigned to your account.");
+      const beneficiaryId = account.beneficiaryId;
+      const distributionId = schedule.distributionId;
+      const distribution = await tx.distribution.findUniqueOrThrow({
+        where: { distributionId }, select: { verificationRequirement: true },
+      });
+      assertQrVerificationConfigured(distribution);
+      const claim = await tx.claim.findUnique({
+        where: { beneficiaryId_distributionId: { beneficiaryId, distributionId } },
+        select: { claimId: true, claimStatus: true, biometricVerified: true, qrVerified: true },
+      });
+      let qrToken = await tx.qrToken.findUnique({
+        where: { beneficiaryId_distributionId: { beneficiaryId, distributionId } },
+      });
+      if (!qrToken) {
+        const qrTokenId = randomUUID();
+        qrToken = await tx.qrToken.create({ data: {
+          qrTokenId, beneficiaryId, distributionId,
+          tokenHash: hashQrToken(mobileQrCredential(qrTokenId)), expiresAt: new Date(schedule.slotEnd),
+        } });
+        await tx.auditLog.create({ data: {
+          actorType: "BENEFICIARY", action: "MOBILE_QR_PASS_ISSUED", entityAffected: "QR_TOKEN", recordId: qrTokenId,
+          details: { source: "MOBILE_APP", beneficiaryId, distributionId },
+        } });
+      }
+      const outcome = qrClaimPreviewOutcome({
+        distribution, qrToken, schedule: { status: schedule.status.toUpperCase() },
+        allocation: { allocationStatus: "ALLOCATED" }, existingClaim: claim,
+      });
+      if (!outcome.ok) {
+        const code = ({ QR_TOKEN_REVOKED: "CLAIM_PASS_REVOKED", QR_TOKEN_EXPIRED: "CLAIM_PASS_EXPIRED" })[outcome.code]
+          ?? "CLAIM_PASS_PROCESSED";
+        throw new AppError(outcome.statusCode, code, outcome.message);
+      }
+      const claimCode = mobileQrCredential(qrToken.qrTokenId);
+      if (hashQrToken(claimCode) !== qrToken.tokenHash) {
+        throw new AppError(409, "CLAIM_PASS_STAFF_ISSUED", "Staff issued this credential separately. Ask them for your pass; the mobile app cannot replace it.");
+      }
+      const { id, date, slotStart, slotEnd, queueNumber, location, program } = schedule;
+      return {
+        id: qrToken.qrTokenId, claimCode, status: "active",
+        issuedAt: qrToken.createdAt.toISOString(), expiresAt: qrToken.expiresAt.toISOString(),
+        schedule: { id, distributionId, date, slotStart, slotEnd, queueNumber, location,
+          program: { id: program.id, code: program.code, name: program.name } },
+      };
+    }, { isolationLevel: "Serializable" });
+  } catch (error) {
+    if (["P2034", "P2002"].includes(error.code)) {
+      throw new AppError(409, "QR_CLAIM_CONCURRENT_CHANGE", "QR or claim data changed concurrently. Refresh and try again.");
+    }
+    throw error;
+  }
+}
diff --git a/src/modules/mobile/mobileDocuments.controller.js b/src/modules/mobile/mobileDocuments.controller.js
new file mode 100644
index 0000000000000000000000000000000000000000..9108fa878b65cd0a7f95dd49bdaa73e35f0d0e69
--- /dev/null
+++ b/src/modules/mobile/mobileDocuments.controller.js
@@ -0,0 +1,99 @@
+import { access } from "node:fs/promises";
+import prisma from "../../lib/prisma.js";
+import { AppError } from "../../utils/AppError.js";
+import { asyncHandler } from "../../utils/asyncHandler.js";
+import { prepareUploadedDocument, removeUploadedFile } from "../documents/beneficiaryDocument.controller.js";
+import { assertBeneficiaryDocumentReplacementTransition, resolveBeneficiaryDocumentPath } from "../documents/beneficiaryDocument.service.js";
+import { lockMobileSession } from "./mobile.service.js";
+
+// Only beneficiary-facing metadata; never expose file paths, hashes, or staff identities.
+const mobileDocumentSelect = {
+  documentId: true, documentType: true, originalFileName: true, mimeType: true, fileSize: true,
+  reviewStatus: true, reviewedAt: true, reviewNotes: true, replacesDocumentId: true, createdAt: true,
+};
+
+function mobileDocument(document) {
+  return {
+    id: document.documentId, docType: document.documentType.toLowerCase(),
+    originalName: document.originalFileName, mimeType: document.mimeType, sizeBytes: document.fileSize,
+    status: ({ SUBMITTED: "received", ACCEPTED: "accepted", REJECTED: "rejected", SUPERSEDED: "superseded" })[document.reviewStatus],
+    reviewNotes: document.reviewNotes, reviewedAt: document.reviewedAt,
+    replacesDocumentId: document.replacesDocumentId, canReplace: document.reviewStatus === "REJECTED", createdAt: document.createdAt,
+  };
+}
+
+export const listMobileDocuments = asyncHandler(async (req, res) => {
+  const documents = await prisma.beneficiaryDocument.findMany({
+    where: { beneficiaryId: req.mobileSession.account.beneficiaryId, reviewStatus: { not: "REMOVED" } },
+    select: mobileDocumentSelect, orderBy: [{ createdAt: "desc" }, { documentId: "desc" }],
+  });
+  res.json({ success: true, data: documents.map(mobileDocument) });
+});
+
+export const uploadMobileDocument = asyncHandler(async (req, res) => {
+  let keepFile = false;
+  try {
+    const uploaded = await prepareUploadedDocument(req);
+    const replacementId = req.validatedParams?.documentId;
+    const result = await prisma.$transaction(async (tx) => {
+      // Recheck revocation after receiving the file and serialize mobile retries for this account.
+      const account = await lockMobileSession(tx, req.mobileSession);
+      const beneficiaryId = account.beneficiaryId;
+      if (replacementId) {
+        const original = await tx.beneficiaryDocument.findFirst({ where: { documentId: replacementId, beneficiaryId } });
+        if (!original) throw new AppError(404, "BENEFICIARY_DOCUMENT_NOT_FOUND", "Document not found.");
+        if (original.documentType === "OTHER") {
+          if (uploaded.documentName && original.documentName && uploaded.documentName.toLowerCase() !== original.documentName.toLowerCase()) {
+            throw new AppError(409, "DOCUMENT_NAME_MISMATCH", "Replace the same named document; upload a different requirement separately.");
+          }
+          uploaded.documentName ??= original.documentName ?? null;
+        }
+        const existing = await tx.beneficiaryDocument.findUnique({ where: { replacesDocumentId: replacementId } });
+        if (existing) {
+          if (existing.reviewStatus === "REMOVED" || existing.checksum !== uploaded.checksum || existing.documentType !== uploaded.documentType) {
+            throw new AppError(409, "DOCUMENT_STATUS_CHANGED", "This document already has a correction. Refresh your documents.");
+          }
+          return { document: existing, created: false };
+        }
+        assertBeneficiaryDocumentReplacementTransition(original, { beneficiaryId, documentType: uploaded.documentType });
+        const changed = await tx.beneficiaryDocument.updateMany({
+          where: { documentId: replacementId, beneficiaryId, reviewStatus: "REJECTED" }, data: { reviewStatus: "SUPERSEDED" },
+        });
+        if (changed.count !== 1) throw new AppError(409, "DOCUMENT_STATUS_CHANGED", "The review status changed. Refresh your documents.");
+      } else {
+        const existing = await tx.beneficiaryDocument.findFirst({
+          where: { beneficiaryId, documentType: uploaded.documentType, documentName: uploaded.documentName, checksum: uploaded.checksum, reviewStatus: { notIn: ["SUPERSEDED", "REMOVED"] } },
+          orderBy: { createdAt: "desc" },
+        });
+        if (existing) return { document: existing, created: false };
+      }
+      const document = await tx.beneficiaryDocument.create({ data: {
+        ...uploaded, beneficiaryId, uploadedByBeneficiaryId: beneficiaryId,
+        reviewStatus: "SUBMITTED", ...(replacementId ? { replacesDocumentId: replacementId } : {}),
+      }, select: mobileDocumentSelect });
+      await tx.auditLog.create({ data: {
+        actorType: "BENEFICIARY", action: replacementId ? "MOBILE_DOCUMENT_REPLACED" : "MOBILE_DOCUMENT_UPLOADED",
+        entityAffected: "BENEFICIARY_DOCUMENT", recordId: document.documentId,
+        details: { source: "MOBILE_APP", beneficiaryId, documentType: document.documentType, ...(replacementId ? { replacesDocumentId: replacementId } : {}) },
+      } });
+      return { document, created: true };
+    });
+    keepFile = result.created;
+    res.status(result.created ? 201 : 200).json({ success: true, data: mobileDocument(result.document) });
+  } finally {
+    if (!keepFile) await removeUploadedFile(req.file);
+  }
+});
+
+export const downloadMobileDocument = asyncHandler(async (req, res, next) => {
+  const document = await prisma.beneficiaryDocument.findFirst({
+    where: { documentId: req.validatedParams.documentId, beneficiaryId: req.mobileSession.account.beneficiaryId, reviewStatus: { not: "REMOVED" } },
+    select: { originalFileName: true, filePath: true },
+  });
+  if (!document) throw new AppError(404, "BENEFICIARY_DOCUMENT_NOT_FOUND", "Document not found.");
+  const file = resolveBeneficiaryDocumentPath(document.filePath);
+  try { await access(file); } catch { throw new AppError(404, "DOCUMENT_FILE_NOT_FOUND", "The stored file is unavailable."); }
+  res.set("X-Content-Type-Options", "nosniff");
+  res.set("Cache-Control", "private, no-store");
+  res.download(file, document.originalFileName, (error) => { if (error) next(error); });
+});
diff --git a/src/modules/mobile/mobileOverview.service.js b/src/modules/mobile/mobileOverview.service.js
new file mode 100644
index 0000000000000000000000000000000000000000..336f9f7735f6baf759e8cdda270358b6762501f9
--- /dev/null
+++ b/src/modules/mobile/mobileOverview.service.js
@@ -0,0 +1,65 @@
+import prisma from "../../lib/prisma.js";
+import { distributionSlotToResponse } from "../distributions/distributionSlot.service.js";
+
+const programSelect = {
+  programId: true, programCode: true, programName: true, programType: true,
+  description: true, grantAmount: true,
+};
+
+function mobileProgram(program) {
+  return {
+    id: program.programId, code: program.programCode, name: program.programName,
+    type: program.programType, description: program.description,
+    grantAmount: program.grantAmount === null ? null : Number(program.grantAmount),
+  };
+}
+
+export async function getMobileOverview(session, database = prisma) {
+  const beneficiaryId = session.account.beneficiaryId;
+  const [enrollments, schedule] = await Promise.all([
+    database.enrollment.findMany({
+      where: { beneficiaryId },
+      select: {
+        enrollmentId: true, enrollmentDate: true, status: true,
+        reviewNotes: true, reviewedAt: true, program: { select: programSelect },
+      },
+      orderBy: [{ enrollmentDate: "desc" }, { enrollmentId: "asc" }],
+    }),
+    database.schedule.findFirst({
+      where: {
+        beneficiaryId, status: { in: ["SCHEDULED", "CHECKED_IN"] },
+        slot: { slotEnd: { gt: new Date() }, slotStatus: { not: "CLOSED" } },
+        distribution: {
+          status: "OPEN", program: { status: "ACTIVE" },
+          allocations: { some: {
+            beneficiaryId, allocationStatus: "ALLOCATED", enrollment: { status: "APPROVED" },
+          } },
+        },
+      },
+      select: {
+        scheduleId: true, distributionId: true, queueNumber: true, status: true,
+        slot: { select: { slotStart: true, slotEnd: true, location: true } },
+        distribution: { select: { title: true, program: { select: programSelect } } },
+      },
+      orderBy: [{ slot: { slotStart: "asc" } }, { scheduleId: "asc" }],
+    }),
+  ]);
+  const slot = schedule ? distributionSlotToResponse(schedule.slot) : null;
+  return {
+    enrollments: enrollments.map(enrollment => ({
+      id: enrollment.enrollmentId,
+      enrollmentDate: enrollment.enrollmentDate.toISOString().slice(0, 10),
+      status: enrollment.status.toLowerCase(),
+      reviewNotes: enrollment.reviewNotes,
+      reviewedAt: enrollment.reviewedAt?.toISOString() ?? null,
+      program: mobileProgram(enrollment.program),
+    })),
+    nextSchedule: schedule ? {
+      id: schedule.scheduleId, distributionId: schedule.distributionId,
+      title: schedule.distribution.title, date: slot.slotStart.slice(0, 10),
+      slotStart: slot.slotStart, slotEnd: slot.slotEnd,
+      queueNumber: schedule.queueNumber, status: schedule.status.toLowerCase(),
+      location: schedule.slot.location, program: mobileProgram(schedule.distribution.program),
+    } : null,
+  };
+}
