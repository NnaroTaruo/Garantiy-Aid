+  const otp = (contactNumber, purpose, code) => request("/mobile/auth/otp/verify", { body: { contactNumber, purpose, code } });
+  const coolDown = (accountId) => prisma.beneficiaryMobileOtp.updateMany({ where: { accountId }, data: { createdAt: new Date(Date.now() - 61_000) } });
+  try {
+    for (const [id, active] of [[barangayId, true], [inactiveId, false]]) await prisma.barangay.create({ data: {
+      barangayId: id, barangayCode: id.slice(0, 20), barangayName: "Mobile integration test", city: "Test", province: "Test", isActive: active,
