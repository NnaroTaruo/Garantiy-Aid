+
+export function getMobileNotificationPreferences(session) {
+  return Object.fromEntries(Object.keys(preferenceSelect).map(key => [key, session.account[key]]));
+}
+
+export async function updateMobileNotificationPreferences(session, input) {
+  return prisma.$transaction(async tx => {
+    const account = await lockMobileSession(tx, session);
+    const saved = await tx.beneficiaryMobileAccount.update({ where: { accountId: account.accountId }, data: input, select: preferenceSelect });
+    await tx.auditLog.create({ data: { actorType: "BENEFICIARY", action: "MOBILE_NOTIFICATION_PREFERENCES_UPDATED",
+      entityAffected: "BENEFICIARY", recordId: account.beneficiaryId, details: { source: "MOBILE_APP" } } });
+    return saved;
+  });
+}
 
