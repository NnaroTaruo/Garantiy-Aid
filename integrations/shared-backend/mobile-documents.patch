+import test from "node:test";
+import assert from "node:assert/strict";
+import { decodeDocumentFileName } from "../src/modules/documents/beneficiaryDocument.file.js";
+
+test("multipart document names preserve UTF-8, legacy names, and literal percent characters", () => {
+  for (const name of ["Málaga ñ sample.pdf", "文件.png", "Simple.pdf", "100%20sample.pdf"]) {
+    assert.equal(decodeDocumentFileName(Buffer.from(name, "utf8").toString("latin1")), name);
+  }
+  assert.equal(decodeDocumentFileName("Bañales.pdf"), "Bañales.pdf");
+  assert.equal(decodeDocumentFileName("文件.png"), "文件.png");
+});
diff --git a/test/mobile-documents.integration.js b/test/mobile-documents.integration.js
new file mode 100644
index 0000000000000000000000000000000000000000..9d1036e688ba750d61c07317a7deb9ea6de483f8
--- /dev/null
+++ b/test/mobile-documents.integration.js
@@ -0,0 +1,130 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { randomUUID, randomInt } from "node:crypto";
+import { once } from "node:events";
+import { mkdtemp, readdir, rmdir, unlink } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { setTimeout as delay } from "node:timers/promises";
+
+test("private mobile documents share staff review, safe corrections, retries, and ownership", { skip: process.env.RUN_MOBILE_DB_TESTS !== "1" }, async () => {
+  const directory = await mkdtemp(join(tmpdir(), "garantiyaid-shared-documents-"));
+  process.env.DOCUMENT_STORAGE_DIR = directory;
+  const [{ default: app }, { default: prisma }, { signAccessToken }] = await Promise.all([
+    import("../src/app.js"), import("../src/lib/prisma.js"), import("../src/modules/auth/auth.service.js"),
+  ]);
+  const server = app.listen(0, "127.0.0.1");
+  await once(server, "listening");
+  const base = `http://127.0.0.1:${server.address().port}/api/v1`;
+  const collection = "/mobile/beneficiaries/me/documents";
+  const barangayId = randomUUID(), userId = randomUUID(), staffSessionId = randomUUID();
+  const beneficiaries = [];
+  const pdf = Buffer.from("%PDF-1.4\nSynthetic document, no personal data.\n%%EOF");
+  const call = (path, token, init = {}) => fetch(base + path, { ...init, headers: { ...(token ? { Authorization: `Bearer ${token}` } : {}), ...init.headers } });
+  const upload = (token, { path = collection, bytes = pdf, type = "PROOF_OF_RESIDENCY", name = "Sample.pdf", extra } = {}) => {
+    const body = new FormData(); body.set("documentType", type); body.set("file", new Blob([bytes], { type: "application/pdf" }), name);
+    if (extra) body.set("beneficiaryId", extra);
+    return call(path, token, { method: "POST", body });
+  };
+  const createAccount = async (lastName) => {
+    const contactNumber = `+639${randomInt(100_000_000, 1_000_000_000)}`;
+    const registered = await call("/mobile/auth/register", undefined, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({
+      firstName: "Document", middleName: "", lastName, contactNumber, barangayId, birthDate: "1990-01-01", sex: "female", address: "12 Synthetic Street",
+    }) });
+    assert.equal(registered.status, 201);
+    const data = (await registered.json()).data; beneficiaries.push(data.beneficiary.id);
+    const verified = await call("/mobile/auth/otp/verify", undefined, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ contactNumber, purpose: "register", code: data.developmentOtp }) });
+    return (await verified.json()).data.accessToken;
+  };
+  try {
+    await prisma.barangay.create({ data: { barangayId, barangayCode: barangayId.slice(0, 20), barangayName: "Document integration test", city: "Test", province: "Test" } });
+    await prisma.user.create({ data: { userId, employeeId: userId.slice(0, 20), fullName: "Synthetic Reviewer", email: `${userId}@example.invalid`, passwordHash: "not-a-login-password", role: "DSWD_STAFF", username: null } });
+    await prisma.staffSession.create({ data: { sessionId: staffSessionId, userId, expiresAt: new Date(Date.now() + 300_000) } });
+    const staffToken = signAccessToken({ userId, role: "DSWD_STAFF" }, { jwtId: staffSessionId });
+    const owner = await createAccount("Owner"), other = await createAccount("Other");
+    assert.equal((await upload()).status, 401);
+    assert.equal((await call(collection)).status, 401);
+    assert.deepEqual(await readdir(directory), []);
+    assert.equal((await upload(owner, { bytes: Buffer.alloc(0) })).status, 400);
+    assert.equal((await upload(owner, { bytes: Buffer.from("not a PDF") })).status, 400);
+    assert.equal((await upload(owner, { type: "APPROVED" })).status, 400);
+    assert.equal((await upload(owner, { bytes: Buffer.alloc(5 * 1024 * 1024 + 1) })).status, 400);
+    assert.equal((await upload(owner, { extra: beneficiaries[1] })).status, 400);
+    assert.deepEqual(await readdir(directory), []);
+    const responses = await Promise.all([upload(owner), upload(owner)]);
+    assert.deepEqual(responses.map((response) => response.status).sort(), [200, 201]);
+    const saved = (await responses[0].json()).data;
+    assert.equal((await responses[1].json()).data.id, saved.id);
+    assert.equal(saved.status, "received");
+    for (const key of ["checksum", "filePath", "uploadedById", "beneficiaryId"]) assert.equal(key in saved, false);
+    assert.equal((await readdir(directory)).length, 1);
+    const stored = await prisma.beneficiaryDocument.findUnique({ where: { documentId: saved.id } });
+    assert.equal(stored.uploadedById, null);
+    assert.equal(stored.uploadedByBeneficiaryId, beneficiaries[0]);
+    await assert.rejects(prisma.beneficiaryDocument.update({ where: { documentId: saved.id }, data: { uploadedById: userId } }),
+      (error) => error.message.includes("beneficiary_documents_uploader_check"));
+    await assert.rejects(prisma.beneficiaryDocument.update({ where: { documentId: saved.id }, data: { uploadedByBeneficiaryId: beneficiaries[1] } }),
+      (error) => error.message.includes("beneficiary_documents_uploader_check"));
+    assert.equal((await call(`${collection}/${saved.id}/content`, other)).status, 404);
+    assert.equal((await call(`${collection}/${saved.id}/content`)).status, 401);
+    const downloaded = await call(`${collection}/${saved.id}/content`, owner);
+    assert.equal(downloaded.headers.get("Cache-Control"), "private, no-store");
+    assert.equal(downloaded.headers.get("X-Content-Type-Options"), "nosniff");
+    assert.deepEqual(Buffer.from(await downloaded.arrayBuffer()), pdf);
+    assert.deepEqual((await (await call(collection, other)).json()).data, []);
+    const list = await call(`/beneficiaries/${beneficiaries[0]}/documents`, staffToken);
+    assert.ok((await list.json()).data.documents.some((document) => document.documentId === saved.id));
+    const reviewPath = `/beneficiaries/${beneficiaries[0]}/documents/${saved.id}/review`;
+    const review = (path, body, token = staffToken) => call(path, token, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
+    assert.equal((await review(reviewPath, { decision: "ACCEPTED" }, owner)).status, 401);
+    assert.equal((await review(reviewPath, { decision: "REJECTED", reason: "Please upload a clearer copy." })).status, 200);
+    const rejected = (await (await call(collection, owner)).json()).data[0];
+    assert.equal(rejected.status, "rejected"); assert.equal(rejected.canReplace, true);
+    assert.equal(rejected.reviewNotes, "Please upload a clearer copy.");
+    assert.equal((await upload(other, { path: `${collection}/${saved.id}/replacement` })).status, 404);
+    assert.equal((await upload(owner, { path: `${collection}/${saved.id}/replacement`, type: "VALID_ID" })).status, 409);
+    assert.equal((await upload(owner, { path: `${collection}/invalid/replacement` })).status, 400);
+    const correctedBytes = Buffer.from("%PDF-1.4\nCorrected synthetic document\n%%EOF");
+    const correctedResponses = await Promise.all([upload(owner, { path: `${collection}/${saved.id}/replacement`, bytes: correctedBytes }), upload(owner, { path: `${collection}/${saved.id}/replacement`, bytes: correctedBytes })]);
+    assert.deepEqual(correctedResponses.map((response) => response.status).sort(), [200, 201]);
+    const corrected = (await correctedResponses[0].json()).data;
+    assert.equal(corrected.replacesDocumentId, saved.id); assert.equal(corrected.status, "received");
+    assert.equal((await correctedResponses[1].json()).data.id, corrected.id);
+    assert.equal((await readdir(directory)).length, 2);
+    assert.equal((await review(`/beneficiaries/${beneficiaries[0]}/documents/${corrected.id}/review`, { decision: "ACCEPTED" })).status, 200);
+    const documents = (await (await call(collection, owner)).json()).data;
+    assert.equal(documents.find((document) => document.id === saved.id).status, "superseded");
+    assert.equal(documents.find((document) => document.id === corrected.id).status, "accepted");
+    assert.equal((await upload(owner, { path: `${collection}/${corrected.id}/replacement` })).status, 409);
+    assert.equal(await prisma.enrollment.count({ where: { beneficiaryId: beneficiaries[0] } }), 0);
+    assert.equal((await prisma.beneficiary.findUnique({ where: { beneficiaryId: beneficiaries[0] } })).isVerified, false);
+    assert.equal((await call("/mobile/auth/logout", owner, { method: "POST" })).status, 204);
+    assert.equal((await upload(owner)).status, 401);
+    assert.equal((await call(`/uploads/beneficiary-documents/${saved.id}.upload`, other)).status, 404);
+    const boundary = `mobile-${randomUUID()}`;
+    let finishUpload;
+    const slowBody = new ReadableStream({ start(controller) {
+      controller.enqueue(Buffer.from(`--${boundary}\r\nContent-Disposition: form-data; name="documentType"\r\n\r\nOTHER\r\n--${boundary}\r\nContent-Disposition: form-data; name="file"; filename="Slow.pdf"\r\nContent-Type: application/pdf\r\n\r\n%PDF-1.4\n`));
+      finishUpload = () => { controller.enqueue(Buffer.from(`Synthetic streamed file\n%%EOF\r\n--${boundary}--\r\n`)); controller.close(); };
+    } });
+    const inFlight = call(collection, other, { method: "POST", headers: { "Content-Type": `multipart/form-data; boundary=${boundary}` }, body: slowBody, duplex: "half" });
+    try {
+      for (let attempt = 0; attempt < 100 && (await readdir(directory)).length === 2; attempt++) await delay(20);
+      assert.equal((await readdir(directory)).length, 3, "The upload must have passed authentication and started writing before logout.");
+      assert.equal((await call("/mobile/auth/logout", other, { method: "POST" })).status, 204);
+    } finally { finishUpload(); }
+    assert.equal((await inFlight).status, 401);
+    assert.equal((await readdir(directory)).length, 2, "The file received after revocation must be removed.");
+  } finally {
+    await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+    const documents = await prisma.beneficiaryDocument.findMany({ where: { beneficiaryId: { in: beneficiaries } }, select: { documentId: true } });
+    await prisma.auditLog.deleteMany({ where: { recordId: { in: [...beneficiaries, ...documents.map((document) => document.documentId)] } } });
+    await prisma.beneficiaryDocument.deleteMany({ where: { beneficiaryId: { in: beneficiaries } } });
+    await prisma.beneficiary.deleteMany({ where: { beneficiaryId: { in: beneficiaries } } });
+    await prisma.user.deleteMany({ where: { userId } });
+    await prisma.barangay.deleteMany({ where: { barangayId } });
+    await prisma.$disconnect();
+    for (const file of await readdir(directory)) await unlink(join(directory, file));
+    await rmdir(directory);
+  }
+});
