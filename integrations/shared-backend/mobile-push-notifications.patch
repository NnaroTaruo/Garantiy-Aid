diff --git a/src/workers/mobilePush.worker.js b/src/workers/mobilePush.worker.js
new file mode 100644
index 0000000..8b7baa2
--- /dev/null
+++ b/src/workers/mobilePush.worker.js
@@ -0,0 +1,30 @@
+import prisma from "../lib/prisma.js";
+import { env } from "../config/env.js";
+import { checkMobilePushReceipts, dispatchMobilePushes, sweepMobilePushes } from "../modules/mobile/mobilePush.dispatcher.js";
+
+// Polls the committed push outbox. Uncommitted staff transactions are invisible here, so alerts
+// are only sent after commit. Database claims let several API instances share the work safely.
+export function startMobilePushDispatcher({ database = prisma, intervalMs = env.mobilePushDispatchIntervalMs } = {}) {
+  let stopping = false;
+  let timer;
+  let pending = Promise.resolve();
+  let lastHousekeeping = 0;
+  async function tick() {
+    try {
+      if (Date.now() - lastHousekeeping > 60_000) {
+        await sweepMobilePushes({ database });
+        lastHousekeeping = Date.now();
+      }
+      let batch;
+      do { batch = await dispatchMobilePushes({ database }); } while (!stopping && batch.claimed > 0);
+      await checkMobilePushReceipts({ database });
+    } catch (error) {
+      // Codes only: provider and device details never reach logs.
+      console.warn({ event: "MOBILE_PUSH_DISPATCH_UNAVAILABLE", errorCode: error.code ?? "DATABASE_UNAVAILABLE" });
+    } finally {
+      if (!stopping) { timer = setTimeout(() => { pending = tick(); }, intervalMs); timer.unref?.(); }
+    }
+  }
+  pending = tick();
+  return async () => { stopping = true; clearTimeout(timer); await pending; };
+}
