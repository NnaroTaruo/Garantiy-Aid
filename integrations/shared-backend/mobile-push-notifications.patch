+    // An expired session stops queued alerts at send time and its token is purged.
+    await enable(first, tokens[2]);
+    await notify(first.beneficiaryId, "ASSISTANCE_RELEASED");
+    await prisma.beneficiaryMobileSession.updateMany({ where: { account: { beneficiaryId: first.beneficiaryId } }, data: { expiresAt: new Date(Date.now() - 1) } });
+    assert.equal((await dispatchMobilePushes({ sender: okSender })).cancelled, 1);
+    assert.equal((await deliveries(first.beneficiaryId)).at(-1).lastErrorCode, "SESSION_INACTIVE");
+    assert.ok((await sweepMobilePushes()).inactiveDevices >= 1);
+    assert.equal(await prisma.beneficiaryMobilePushDevice.count({ where: { account: { beneficiaryId: first.beneficiaryId } } }), 0);
+
+    // With push disabled the server reports it clearly and refuses registration.
+    env.mobilePushMode = "DISABLED";
+    const third = await signUp("Charlie");
+    assert.equal((await request("/beneficiaries/me/push-device", { token: third.accessToken })).body.data.status, "unavailable");
+    const refused = await enable(third, tokens[1]);
+    assert.equal(refused.status, 503);
+    assert.equal(refused.body.error.code, "PUSH_UNAVAILABLE");
+
+    assert.ok(!logged.some((line) => line.includes("PushToken") || line.includes("synthetic-phone")), "Tokens never reach logs");
+  } finally {
+    env.mobilePushMode = savedMode;
+    Object.assign(console, original);
+    await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+    await prisma.notification.deleteMany({ where: { beneficiaryId: { in: ids } } });
+    await prisma.auditLog.deleteMany({ where: { recordId: { in: ids }, actorType: "BENEFICIARY" } });
+    await prisma.beneficiary.deleteMany({ where: { beneficiaryId: { in: ids } } });
+    await prisma.barangay.deleteMany({ where: { barangayId } });
+    await prisma.$disconnect();
+  }
+});
diff --git a/test/mobile-push.test.js b/test/mobile-push.test.js
new file mode 100644
index 0000000..9d066af
--- /dev/null
+++ b/test/mobile-push.test.js
@@ -0,0 +1,147 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { randomUUID } from "node:crypto";
+import { env } from "../src/config/env.js";
+import { getExpoPushReceipts, PushProviderError, sendExpoPushMessages } from "../src/modules/mobile/mobilePush.expo.js";
+import { decryptPushToken, encryptPushToken, mobilePushConfigured, queueMobilePushDeliveries } from "../src/modules/mobile/mobilePush.service.js";
+import { dispatchMobilePushes, mobilePushMessage } from "../src/modules/mobile/mobilePush.dispatcher.js";
+import { mobilePushDeviceSchema } from "../src/modules/mobile/mobile.schemas.js";
+
+const token = "ExponentPushToken[synthetic-device_0001]";
+
+function withEnv(values, callback) {
+  const saved = Object.fromEntries(Object.keys(values).map((key) => [key, env[key]]));
+  Object.assign(env, values);
+  return Promise.resolve().then(callback).finally(() => Object.assign(env, saved));
+}
+
+const configured = { mobilePushMode: "EXPO", mobileAuthSecret: "synthetic-mobile-secret-at-least-32-chars", fieldEncryptionKey: "a".repeat(64), mobilePushExpoAccessToken: undefined, mobilePushTimeoutMs: 1_000 };
+
+test("Expo requests send JSON batches, optional access tokens and map tickets without echoing provider text", () => withEnv({ ...configured, mobilePushExpoAccessToken: "synthetic-expo-access" }, async () => {
+  const calls = [];
+  const fetchImpl = async (url, init) => {
+    calls.push({ url, init });
+    return new Response(JSON.stringify({ data: [
+      { status: "ok", id: "receipt-1" },
+      { status: "error", message: `"${token}" is not a registered push notification recipient`, details: { error: "DeviceNotRegistered" } },
+      { status: "error", message: "unexpected", details: { error: `<${token}>` } },
+    ] }), { status: 200 });
+  };
+  const messages = [mobilePushMessage(token, randomUUID(), "en"), mobilePushMessage(token, randomUUID(), "bs"), mobilePushMessage(token, randomUUID(), "xx")];
+  const tickets = await sendExpoPushMessages(messages, { fetchImpl });
+  assert.equal(calls[0].url, "https://exp.host/--/api/v2/push/send");
+  assert.equal(calls[0].init.method, "POST");
+  assert.equal(calls[0].init.headers.Authorization, "Bearer synthetic-expo-access");
+  assert.deepEqual(JSON.parse(calls[0].init.body), messages);
+  assert.ok(!calls[0].url.includes("PushToken"), "Tokens never travel in URLs");
+  assert.deepEqual(tickets, [{ ok: true, ticketId: "receipt-1" }, { ok: false, errorCode: "DeviceNotRegistered" }, { ok: false, errorCode: "PushTicketError" }]);
+  assert.ok(!JSON.stringify(tickets).includes("PushToken"));
+  await assert.rejects(sendExpoPushMessages(Array.from({ length: 101 }, () => messages[0]), { fetchImpl }), RangeError);
+}));
+
+test("provider failures are classified for retry without exposing tokens", () => withEnv(configured, async () => {
+  const respond = (status, body) => async () => new Response(JSON.stringify(body), { status });
+  const failure = async (fetchImpl) => {
+    try { await sendExpoPushMessages([mobilePushMessage(token, randomUUID(), "en")], { fetchImpl }); }
+    catch (error) { return error; }
+    assert.fail("Expected a provider failure");
+  };
+  for (const status of [429, 500, 503]) {
+    const error = await failure(respond(status, { errors: [{ code: "TOO_MANY_REQUESTS", message: token }] }));
+    assert.ok(error instanceof PushProviderError);
+    assert.equal(error.retryable, true);
+    assert.equal(error.code, `PUSH_PROVIDER_HTTP_${status}`);
+  }
+  const unauthorized = await failure(respond(401, { errors: [{ code: "UNAUTHORIZED", message: `bad ${token}` }] }));
+  assert.equal(unauthorized.retryable, false);
+  assert.equal(unauthorized.code, "PUSH_PROVIDER_UNAUTHORIZED");
+  const unreachable = await failure(async () => { throw new TypeError(`fetch failed for ${token}`); });
+  assert.equal(unreachable.code, "PUSH_PROVIDER_UNREACHABLE");
+  assert.equal(unreachable.retryable, true);
+  const timeout = await failure((_url, init) => new Promise((_resolve, reject) => init.signal.addEventListener("abort", () => reject(new DOMException("aborted", "AbortError")))));
+  assert.equal(timeout.code, "PUSH_PROVIDER_TIMEOUT");
+  assert.equal(timeout.retryable, false, "An accepted-but-unconfirmed batch is not resent");
+  const short = await failure(respond(200, { data: [] }));
+  assert.equal(short.code, "PUSH_PROVIDER_INVALID_RESPONSE");
+  for (const error of [unauthorized, unreachable, timeout, short]) assert.ok(!`${error.message}${error.code}`.includes("PushToken"));
+}));
+
+test("receipts map delivered and unregistered devices and skip unknown ids", () => withEnv(configured, async () => {
+  let body;
+  const receipts = await getExpoPushReceipts(["a", "b", "missing"], { fetchImpl: async (url, init) => {
+    assert.equal(url, "https://exp.host/--/api/v2/push/getReceipts");
+    body = JSON.parse(init.body);
+    return new Response(JSON.stringify({ data: { a: { status: "ok" }, b: { status: "error", message: token, details: { error: "DeviceNotRegistered" } } } }));
+  } });
+  assert.deepEqual(body, { ids: ["a", "b", "missing"] });
+  assert.deepEqual([...receipts], [["a", { ok: true }], ["b", { ok: false, errorCode: "DeviceNotRegistered" }]]);
+}));
+
+test("provider deadlines include a stalled response body for sends and receipt lookups", () => withEnv({ ...configured, mobilePushTimeoutMs: 15 }, async () => {
+  for (const request of [
+    fetchImpl => sendExpoPushMessages([mobilePushMessage(token, randomUUID(), "en")], { fetchImpl }),
+    fetchImpl => getExpoPushReceipts(["synthetic-ticket"], { fetchImpl }),
+  ]) {
+    let signal;
+    const result = await Promise.race([
+      request(async (_url, options) => {
+        signal = options.signal;
+        return { status: 200, ok: true, json: () => new Promise((_resolve, reject) => {
+          signal.addEventListener("abort", () => reject(new DOMException("aborted body", "AbortError")), { once: true });
+        }) };
+      }).catch(error => error),
+      new Promise(resolve => setTimeout(() => resolve("deadline was cleared before the body"), 250)),
+    ]);
+    assert.ok(result instanceof PushProviderError);
+    assert.equal(result.code, "PUSH_PROVIDER_TIMEOUT");
+    assert.equal(result.retryable, false, "An accepted but unconfirmed send must not be duplicated");
+    assert.equal(signal.aborted, true);
+  }
+}));
+
+test("lock-screen messages are generic in English and Bisaya and open details by id only", () => {
+  const notificationId = randomUUID();
+  for (const language of ["en", "bs"]) {
+    const message = mobilePushMessage(token, notificationId, language);
+    assert.deepEqual(Object.keys(message).sort(), ["body", "channelId", "data", "priority", "title", "to", "ttl"]);
+    assert.deepEqual(message.data, { kind: "garantiyaid.notification", notificationId });
+    assert.equal(message.title, "GarantiyAid");
+    assert.equal(message.channelId, "account-updates");
+    assert.doesNotMatch(message.body, /enroll|schedule|claim|release|wallet|peso|₱|\d/i);
+  }
+  assert.notEqual(mobilePushMessage(token, notificationId, "en").body, mobilePushMessage(token, notificationId, "bs").body);
+});
+
+test("device tokens are encrypted, bound to their device row, and never stored in plain text", () => withEnv(configured, () => {
+  const deviceId = randomUUID();
+  const sealed = encryptPushToken(token, deviceId);
+  assert.ok(!sealed.includes("PushToken") && !sealed.includes("synthetic-device"));
+  assert.notEqual(sealed, encryptPushToken(token, deviceId), "Each encryption uses a fresh IV");
+  assert.equal(decryptPushToken(sealed, deviceId), token);
+  assert.throws(() => decryptPushToken(sealed, randomUUID()), "Ciphertext copied to another device row is rejected");
+}));
+
+test("push registration input accepts only Expo tokens for Android with a supported language", () => {
+  assert.deepEqual(mobilePushDeviceSchema.parse({ token, platform: "android", language: "bs" }), { token, platform: "android", language: "bs" });
+  assert.ok(mobilePushDeviceSchema.safeParse({ token: "ExpoPushToken[abcdefghij]", platform: "android", language: "en" }).success);
+  for (const body of [
+    { token: "not-a-token", platform: "android", language: "en" },
+    { token: `${token}]`, platform: "android", language: "en" },
+    { token, platform: "ios", language: "en" },
+    { token, platform: "android", language: "tl" },
+    { token, platform: "android", language: "en", beneficiaryId: randomUUID() },
+  ]) {
+    const result = mobilePushDeviceSchema.safeParse(body);
+    assert.equal(result.success, false);
+    assert.ok(!JSON.stringify(result.error.issues.map((issue) => issue.message)).includes(body.token));
+  }
+});
+
+test("disabled or incomplete push configuration queues and sends nothing", () => withEnv({ ...configured, mobilePushMode: "DISABLED" }, async () => {
+  assert.equal(mobilePushConfigured(), false);
+  const database = new Proxy({}, { get: () => { throw new Error("The database must not be used when push is disabled"); } });
+  assert.equal(await queueMobilePushDeliveries(database, [{ notificationId: randomUUID(), beneficiaryId: randomUUID() }]), 0);
+  assert.deepEqual(await dispatchMobilePushes({ database, sender: () => assert.fail("No provider call") }), { claimed: 0, sent: 0, cancelled: 0, failed: 0, retrying: 0 });
+  await withEnv({ mobilePushMode: "EXPO", fieldEncryptionKey: undefined }, () => assert.equal(mobilePushConfigured(), false));
+  await withEnv({ mobilePushMode: "EXPO", mobileAuthSecret: undefined }, () => assert.equal(mobilePushConfigured(), false));
+}));
