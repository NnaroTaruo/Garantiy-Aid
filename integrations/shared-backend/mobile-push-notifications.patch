+-- Additive: per-session Android push opt-in and a post-commit delivery outbox. Existing rows are unchanged.
+-- CreateTable
+CREATE TABLE "beneficiary_mobile_push_devices" (
+    "device_id" UUID NOT NULL,
+    "account_id" UUID NOT NULL,
+    "session_id" UUID NOT NULL,
+    "token_hash" CHAR(64) NOT NULL,
+    "token_ciphertext" TEXT NOT NULL,
+    "platform" VARCHAR(10) NOT NULL,
+    "language" VARCHAR(2) NOT NULL DEFAULT 'en',
+    "disabled_at" TIMESTAMPTZ(6),
+    "disabled_reason" VARCHAR(40),
+    "created_at" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updated_at" TIMESTAMPTZ(6) NOT NULL,
+
+    CONSTRAINT "beneficiary_mobile_push_devices_pkey" PRIMARY KEY ("device_id")
+);
+
+-- CreateTable
+CREATE TABLE "beneficiary_mobile_push_deliveries" (
+    "delivery_id" UUID NOT NULL,
+    "notification_id" UUID NOT NULL,
+    "device_id" UUID NOT NULL,
+    "status" VARCHAR(20) NOT NULL DEFAULT 'PENDING',
+    "attempt_count" INTEGER NOT NULL DEFAULT 0,
+    "next_attempt_at" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "processing_token" UUID,
+    "processing_started_at" TIMESTAMPTZ(6),
+    "ticket_id" VARCHAR(100),
+    "receipt_check_after" TIMESTAMPTZ(6),
+    "receipt_status" VARCHAR(20),
+    "last_error_code" VARCHAR(50),
+    "sent_at" TIMESTAMPTZ(6),
+    "created_at" TIMESTAMPTZ(6) NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    "updated_at" TIMESTAMPTZ(6) NOT NULL,
+
+    CONSTRAINT "beneficiary_mobile_push_deliveries_pkey" PRIMARY KEY ("delivery_id")
+);
+
+-- CreateIndex
+CREATE UNIQUE INDEX "beneficiary_mobile_push_devices_session_id_key" ON "beneficiary_mobile_push_devices"("session_id");
+
+-- CreateIndex
+CREATE UNIQUE INDEX "beneficiary_mobile_push_devices_token_hash_key" ON "beneficiary_mobile_push_devices"("token_hash");
+
+-- CreateIndex
+CREATE INDEX "beneficiary_mobile_push_devices_account_id_idx" ON "beneficiary_mobile_push_devices"("account_id");
+
+-- CreateIndex
+CREATE INDEX "beneficiary_mobile_push_deliveries_status_next_attempt_at_idx" ON "beneficiary_mobile_push_deliveries"("status", "next_attempt_at");
+
+-- CreateIndex
+CREATE INDEX "beneficiary_mobile_push_deliveries_status_receipt_check_aft_idx" ON "beneficiary_mobile_push_deliveries"("status", "receipt_check_after");
+
+-- CreateIndex
+CREATE UNIQUE INDEX "beneficiary_mobile_push_deliveries_notification_id_device_i_key" ON "beneficiary_mobile_push_deliveries"("notification_id", "device_id");
+
+-- AddForeignKey
+ALTER TABLE "beneficiary_mobile_push_devices" ADD CONSTRAINT "beneficiary_mobile_push_devices_account_id_fkey" FOREIGN KEY ("account_id") REFERENCES "beneficiary_mobile_accounts"("account_id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "beneficiary_mobile_push_devices" ADD CONSTRAINT "beneficiary_mobile_push_devices_session_id_fkey" FOREIGN KEY ("session_id") REFERENCES "beneficiary_mobile_sessions"("session_id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "beneficiary_mobile_push_deliveries" ADD CONSTRAINT "beneficiary_mobile_push_deliveries_notification_id_fkey" FOREIGN KEY ("notification_id") REFERENCES "notifications"("notification_id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+-- AddForeignKey
+ALTER TABLE "beneficiary_mobile_push_deliveries" ADD CONSTRAINT "beneficiary_mobile_push_deliveries_device_id_fkey" FOREIGN KEY ("device_id") REFERENCES "beneficiary_mobile_push_devices"("device_id") ON DELETE CASCADE ON UPDATE CASCADE;
+
+
+-- Reject values the dispatcher does not understand.
+ALTER TABLE "beneficiary_mobile_push_devices"
+  ADD CONSTRAINT "beneficiary_mobile_push_devices_platform_check" CHECK ("platform" IN ('android')),
+  ADD CONSTRAINT "beneficiary_mobile_push_devices_language_check" CHECK ("language" IN ('en', 'bs'));
+ALTER TABLE "beneficiary_mobile_push_deliveries"
+  ADD CONSTRAINT "beneficiary_mobile_push_deliveries_status_check" CHECK ("status" IN ('PENDING', 'SENT', 'FAILED', 'CANCELLED')),
+  ADD CONSTRAINT "beneficiary_mobile_push_deliveries_attempt_check" CHECK ("attempt_count" >= 0);
