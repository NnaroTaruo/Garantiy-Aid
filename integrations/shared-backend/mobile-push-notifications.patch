+// Remote push is a separate per-device opt-in bound to the signed-in session that registered it.
+// The provider token is stored encrypted; its keyed hash enforces one owner per physical device.
+model BeneficiaryMobilePushDevice {
+  deviceId        String    @id @default(uuid()) @map("device_id") @db.Uuid
+  registrationId  String    @default(uuid()) @map("registration_id") @db.Uuid
+  accountId       String    @map("account_id") @db.Uuid
+  sessionId       String    @unique @map("session_id") @db.Uuid
+  tokenHash       String    @unique @map("token_hash") @db.Char(64)
+  tokenCiphertext String    @map("token_ciphertext") @db.Text
+  platform        String    @db.VarChar(10)
+  language        String    @default("en") @db.VarChar(2)
+  disabledAt      DateTime? @map("disabled_at") @db.Timestamptz(6)
+  disabledReason  String?   @map("disabled_reason") @db.VarChar(40)
+  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
+  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
+
+  account    BeneficiaryMobileAccount        @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
+  session    BeneficiaryMobileSession        @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
+  deliveries BeneficiaryMobilePushDelivery[]
+
+  @@index([accountId])
+  @@map("beneficiary_mobile_push_devices")
+}
+
+// Outbox rows are written in the staff transaction and sent by the dispatcher only after commit.
+model BeneficiaryMobilePushDelivery {
+  deliveryId          String    @id @default(uuid()) @map("delivery_id") @db.Uuid
+  notificationId      String    @map("notification_id") @db.Uuid
+  deviceId            String    @map("device_id") @db.Uuid
+  status              String    @default("PENDING") @db.VarChar(20)
+  attemptCount        Int       @default(0) @map("attempt_count")
+  nextAttemptAt       DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
+  processingToken     String?   @map("processing_token") @db.Uuid
+  processingStartedAt DateTime? @map("processing_started_at") @db.Timestamptz(6)
+  ticketId            String?   @map("ticket_id") @db.VarChar(100)
+  receiptCheckAfter   DateTime? @map("receipt_check_after") @db.Timestamptz(6)
+  receiptStatus       String?   @map("receipt_status") @db.VarChar(20)
+  lastErrorCode       String?   @map("last_error_code") @db.VarChar(50)
+  sentAt              DateTime? @map("sent_at") @db.Timestamptz(6)
+  sentRegistrationId  String?   @map("sent_registration_id") @db.Uuid
+  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
+  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
+
+  notification Notification                @relation(fields: [notificationId], references: [notificationId], onDelete: Cascade)
+  device       BeneficiaryMobilePushDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
+
+  @@unique([notificationId, deviceId])
+  @@index([status, nextAttemptAt])
+  @@index([status, receiptCheckAfter])
+  @@map("beneficiary_mobile_push_deliveries")
+}
