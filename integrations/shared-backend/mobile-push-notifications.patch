diff --git a/src/modules/mobile/mobilePush.dispatcher.js b/src/modules/mobile/mobilePush.dispatcher.js
new file mode 100644
index 0000000..6abd33c
--- /dev/null
+++ b/src/modules/mobile/mobilePush.dispatcher.js
@@ -0,0 +1,233 @@
+import { randomUUID } from "node:crypto";
+import prisma from "../../lib/prisma.js";
+import { env } from "../../config/env.js";
+import { mobileNotificationPreferenceField } from "./mobileNotifications.service.js";
+import { MOBILE_PUSH_CHANNEL_ID, decryptPushToken, mobilePushConfigured } from "./mobilePush.service.js";
+import { EXPO_MAX_MESSAGES, EXPO_MAX_RECEIPTS, PushProviderError, getExpoPushReceipts, sendExpoPushMessages } from "./mobilePush.expo.js";
+
+export const MOBILE_PUSH_MAX_ATTEMPTS = 3;
+const LEASE_MS = 2 * 60_000;
+const RETRY_BASE_MS = 30_000;
+const RECEIPT_DELAY_MS = 15 * 60_000;
+const RECEIPT_RETENTION_MS = 24 * 60 * 60_000;
+const ALERT_MAX_AGE_MS = 24 * 60 * 60_000;
+const HISTORY_RETENTION_MS = 30 * 24 * 60 * 60_000;
+const retryAt = (attemptCount, now) => new Date(now.getTime() + RETRY_BASE_MS * 2 ** (attemptCount - 1));
+
+// Lock-screen text is generic: no names, programs, amounts, places or staff notes.
+const copy = {
+  en: { title: "GarantiyAid", body: "You have a new account update. Open the app to view it." },
+  bs: { title: "GarantiyAid", body: "Naa kay bag-ong update sa imong account. Ablihi ang app aron makita kini." },
+};
+
+export function mobilePushMessage(token, notificationId, language) {
+  const text = copy[language] ?? copy.en;
+  return {
+    to: token, title: text.title, body: text.body,
+    data: { kind: "garantiyaid.notification", notificationId },
+    channelId: MOBILE_PUSH_CHANNEL_ID, priority: "high", ttl: 24 * 60 * 60,
+  };
+}
+
+function blockReason(row, now) {
+  const { device, notification } = row;
+  if (device.disabledAt) return "DEVICE_DISABLED";
+  const session = device.session;
+  if (session.revokedAt || session.expiresAt <= now || session.authMode !== env.mobileAuthMode) return "SESSION_INACTIVE";
+  const account = device.account;
+  if (!account.verifiedAt || account.beneficiary.status !== "ACTIVE") return "ACCOUNT_INACTIVE";
+  if (notification.beneficiaryId !== account.beneficiaryId) return "OWNER_CHANGED";
+  if (notification.channel !== "IN_APP" || !["SENT", "READ"].includes(notification.status)) return "NOTIFICATION_UNAVAILABLE";
+  if (notification.readAt) return "ALREADY_READ";
+  const preference = mobileNotificationPreferenceField(notification.notificationType);
+  if (!preference || account[preference] === false) return "PREFERENCE_DISABLED";
+  if (row.createdAt.getTime() < now.getTime() - ALERT_MAX_AGE_MS) return "ALERT_EXPIRED";
+  return null;
+}
+
+async function finish(database, deliveryId, processingToken, data) {
+  await database.beneficiaryMobilePushDelivery.updateMany({
+    where: { deliveryId, processingToken },
+    data: { ...data, processingToken: null, processingStartedAt: null },
+  });
+}
+
+async function disableDevice(database, deviceId, registrationId, reason, now) {
+  // Older pre-migration sends have no registration snapshot; they cannot invalidate a current token.
+  if (!registrationId) return false;
+  const changed = await database.beneficiaryMobilePushDevice.updateMany({
+    where: { deviceId, registrationId, disabledAt: null }, data: { disabledAt: now, disabledReason: reason },
+  });
+  if (!changed.count) return false;
+  await database.beneficiaryMobilePushDelivery.updateMany({
+    where: { deviceId, status: "PENDING", processingToken: null, device: { registrationId, disabledAt: { not: null } } },
+    data: { status: "CANCELLED", lastErrorCode: reason },
+  });
+  return true;
+}
+
+// One claimed batch: send outside any database transaction, then record each result only if
+// this dispatcher still owns the row. At-most-once: rows whose outcome is unknown are not resent.
+export async function dispatchMobilePushes({ database = prisma, sender = sendExpoPushMessages, now = new Date(), limit = EXPO_MAX_MESSAGES } = {}) {
+  const outcome = { claimed: 0, sent: 0, cancelled: 0, failed: 0, retrying: 0 };
+  if (!mobilePushConfigured()) return outcome;
+  const processingToken = randomUUID();
+  const claimed = await database.$queryRaw`
+    UPDATE "beneficiary_mobile_push_deliveries"
+       SET "processing_token" = ${processingToken}::uuid, "processing_started_at" = ${now},
+           "attempt_count" = "attempt_count" + 1, "updated_at" = ${now}
+     WHERE "delivery_id" IN (
+       SELECT "delivery_id" FROM "beneficiary_mobile_push_deliveries"
+        WHERE "status" = 'PENDING' AND "processing_token" IS NULL AND "next_attempt_at" <= ${now}
+          AND "attempt_count" < ${MOBILE_PUSH_MAX_ATTEMPTS}
+        ORDER BY "next_attempt_at", "created_at"
+        LIMIT ${Math.min(limit, EXPO_MAX_MESSAGES)}
+        FOR UPDATE SKIP LOCKED)
+    RETURNING "delivery_id"`;
+  outcome.claimed = claimed.length;
+  if (!claimed.length) return outcome;
+  const rows = await database.beneficiaryMobilePushDelivery.findMany({
+    where: { processingToken },
+    select: {
+      deliveryId: true, notificationId: true, attemptCount: true, createdAt: true,
+      notification: { select: { beneficiaryId: true, notificationType: true, channel: true, status: true, readAt: true } },
+      device: { select: {
+        deviceId: true, registrationId: true, tokenCiphertext: true, language: true, disabledAt: true,
+        session: { select: { revokedAt: true, expiresAt: true, authMode: true } },
+        account: { select: { beneficiaryId: true, verifiedAt: true, enrollmentUpdates: true, scheduleUpdates: true, claimUpdates: true,
+          beneficiary: { select: { status: true } } } },
+      } },
+    },
+  });
+  const ready = [];
+  for (const row of rows) {
+    const reason = blockReason(row, now);
+    if (reason) {
+      await finish(database, row.deliveryId, processingToken, { status: "CANCELLED", lastErrorCode: reason });
+      outcome.cancelled += 1;
+      continue;
+    }
+    let token;
+    try { token = decryptPushToken(row.device.tokenCiphertext, row.device.deviceId); } catch { token = null; }
+    if (!token) {
+      await finish(database, row.deliveryId, processingToken, { status: "CANCELLED", lastErrorCode: "TOKEN_UNREADABLE" });
+      await disableDevice(database, row.device.deviceId, row.device.registrationId, "TOKEN_UNREADABLE", now);
+      outcome.cancelled += 1;
+      continue;
+    }
+    ready.push({ row, message: mobilePushMessage(token, row.notificationId, row.device.language) });
+  }
+  if (!ready.length) return outcome;
+
+  let tickets;
+  try {
+    tickets = await sender(ready.map((item) => item.message));
+  } catch (error) {
+    const code = error instanceof PushProviderError ? error.code : "PUSH_PROVIDER_ERROR";
+    const retryable = error instanceof PushProviderError && error.retryable;
+    for (const { row } of ready) {
+      if (retryable && row.attemptCount < MOBILE_PUSH_MAX_ATTEMPTS) {
+        await finish(database, row.deliveryId, processingToken, {
+          lastErrorCode: code, nextAttemptAt: retryAt(row.attemptCount, now),
+        });
+        outcome.retrying += 1;
+      } else {
+        await finish(database, row.deliveryId, processingToken, { status: "FAILED", lastErrorCode: code });
+        outcome.failed += 1;
+      }
+    }
+    return outcome;
+  }
+
+  for (const [index, { row }] of ready.entries()) {
+    const ticket = tickets[index];
+    if (ticket.ok) {
+      await finish(database, row.deliveryId, processingToken, {
+        status: "SENT", sentAt: now, ticketId: ticket.ticketId, lastErrorCode: null, sentRegistrationId: row.device.registrationId,
+        receiptCheckAfter: new Date(now.getTime() + RECEIPT_DELAY_MS),
+      });
+      outcome.sent += 1;
+    } else if (ticket.errorCode === "MessageRateExceeded" && row.attemptCount < MOBILE_PUSH_MAX_ATTEMPTS) {
+      await finish(database, row.deliveryId, processingToken, { status: "PENDING", lastErrorCode: "PUSH_MessageRateExceeded", nextAttemptAt: retryAt(row.attemptCount, now) });
+      outcome.retrying += 1;
+    } else {
+      await finish(database, row.deliveryId, processingToken, { status: "FAILED", lastErrorCode: `PUSH_${ticket.errorCode}`.slice(0, 50) });
+      if (ticket.errorCode === "DeviceNotRegistered") await disableDevice(database, row.device.deviceId, row.device.registrationId, "DEVICE_NOT_REGISTERED", now);
+      outcome.failed += 1;
+    }
+  }
+  return outcome;
+}
+
+// Expo receipts arrive later and report tokens the phone no longer accepts.
+export async function checkMobilePushReceipts({ database = prisma, fetchReceipts = getExpoPushReceipts, now = new Date() } = {}) {
+  const outcome = { checked: 0, delivered: 0, errors: 0, invalidDevices: 0, retrying: 0 };
+  if (!mobilePushConfigured()) return outcome;
+  const processingToken = randomUUID();
+  const claimed = await database.$queryRaw`
+    UPDATE "beneficiary_mobile_push_deliveries"
+       SET "processing_token" = ${processingToken}::uuid, "processing_started_at" = ${now}, "updated_at" = ${now}
+     WHERE "delivery_id" IN (
+       SELECT "delivery_id" FROM "beneficiary_mobile_push_deliveries"
+        WHERE "status" = 'SENT' AND "receipt_status" IS NULL AND "ticket_id" IS NOT NULL
+          AND "receipt_check_after" <= ${now}
+          AND ("processing_token" IS NULL OR "processing_started_at" < ${new Date(now.getTime() - LEASE_MS)})
+        ORDER BY "receipt_check_after"
+        LIMIT ${EXPO_MAX_RECEIPTS}
+        FOR UPDATE SKIP LOCKED)
+    RETURNING "delivery_id", "ticket_id", "device_id", "sent_at", "sent_registration_id", "attempt_count"`;
+  if (!claimed.length) return outcome;
+  const later = new Date(now.getTime() + RECEIPT_DELAY_MS);
+  let receipts;
+  try {
+    receipts = await fetchReceipts(claimed.map((row) => row.ticket_id));
+  } catch {
+    for (const row of claimed) await finish(database, row.delivery_id, processingToken, { receiptCheckAfter: later });
+    return outcome;
+  }
+  for (const row of claimed) {
+    const receipt = receipts.get(row.ticket_id);
+    outcome.checked += 1;
+    if (!receipt) {
+      // Expo keeps receipts for 24 hours; after that the outcome is unknown rather than failed.
+      const expired = new Date(row.sent_at).getTime() < now.getTime() - RECEIPT_RETENTION_MS;
+      await finish(database, row.delivery_id, processingToken, expired ? { receiptStatus: "UNAVAILABLE" } : { receiptCheckAfter: later });
+    } else if (receipt.ok) {
+      await finish(database, row.delivery_id, processingToken, { receiptStatus: "OK" });
+      outcome.delivered += 1;
+    } else if (receipt.errorCode === "MessageRateExceeded" && row.attempt_count < MOBILE_PUSH_MAX_ATTEMPTS) {
+      // Expo accepted the request but the device provider rejected delivery; retry only this alert.
+      await finish(database, row.delivery_id, processingToken, {
+        status: "PENDING", nextAttemptAt: retryAt(row.attempt_count, now), lastErrorCode: "PUSH_MessageRateExceeded",
+        ticketId: null, sentAt: null, sentRegistrationId: null, receiptCheckAfter: null, receiptStatus: null,
+      });
+      outcome.retrying += 1;
+    } else {
+      await finish(database, row.delivery_id, processingToken, { receiptStatus: "ERROR", lastErrorCode: `PUSH_${receipt.errorCode}`.slice(0, 50) });
+      if (receipt.errorCode === "DeviceNotRegistered") {
+        if (await disableDevice(database, row.device_id, row.sent_registration_id, "DEVICE_NOT_REGISTERED", now)) outcome.invalidDevices += 1;
+      }
+      outcome.errors += 1;
+    }
+  }
+  return outcome;
+}
+
+// Housekeeping: unknown in-flight sends are failed (not resent), and inactive sessions lose their tokens.
+export async function sweepMobilePushes({ database = prisma, now = new Date() } = {}) {
+  const stale = await database.beneficiaryMobilePushDelivery.updateMany({
+    where: { status: "PENDING", processingToken: { not: null }, processingStartedAt: { lt: new Date(now.getTime() - LEASE_MS) } },
+    data: { status: "FAILED", lastErrorCode: "PUSH_RESULT_UNKNOWN", processingToken: null, processingStartedAt: null },
+  });
+  const exhausted = await database.beneficiaryMobilePushDelivery.updateMany({
+    where: { status: "PENDING", processingToken: null, attemptCount: { gte: MOBILE_PUSH_MAX_ATTEMPTS } },
+    data: { status: "FAILED", lastErrorCode: "PUSH_ATTEMPTS_EXHAUSTED" },
+  });
+  const inactiveDevices = await database.beneficiaryMobilePushDevice.deleteMany({
+    where: { session: { OR: [{ revokedAt: { not: null } }, { expiresAt: { lte: now } }] } },
+  });
+  const oldHistory = await database.beneficiaryMobilePushDelivery.deleteMany({
+    where: { status: { not: "PENDING" }, updatedAt: { lt: new Date(now.getTime() - HISTORY_RETENTION_MS) } },
+  });
+  return { stale: stale.count, exhausted: exhausted.count, inactiveDevices: inactiveDevices.count, oldHistory: oldHistory.count };
+}
diff --git a/src/modules/mobile/mobilePush.expo.js b/src/modules/mobile/mobilePush.expo.js
new file mode 100644
index 0000000..7d5fe04
--- /dev/null
+++ b/src/modules/mobile/mobilePush.expo.js
@@ -0,0 +1,82 @@
+import { env } from "../../config/env.js";
+
+// Expo Push Service (https://docs.expo.dev/push-notifications/sending-notifications/).
+const SEND_URL = "https://exp.host/--/api/v2/push/send";
+const RECEIPTS_URL = "https://exp.host/--/api/v2/push/getReceipts";
+export const EXPO_MAX_MESSAGES = 100;
+export const EXPO_MAX_RECEIPTS = 1000;
+
+export class PushProviderError extends Error {
+  constructor(code, retryable) {
+    super("The push provider request failed.");
+    this.name = "PushProviderError";
+    this.code = code;
+    this.retryable = retryable;
+  }
+}
+
+// Provider messages can echo device tokens. Only short, known-shaped codes ever leave this module.
+function providerCode(value, fallback) {
+  return typeof value === "string" && /^[A-Za-z_]{3,40}$/.test(value) ? value : fallback;
+}
+
+async function post(url, body, fetchImpl) {
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), env.mobilePushTimeoutMs);
+  try {
+    const response = await fetchImpl(url, {
+      method: "POST",
+      signal: controller.signal,
+      headers: {
+        Accept: "application/json",
+        "Content-Type": "application/json",
+        ...(env.mobilePushExpoAccessToken ? { Authorization: `Bearer ${env.mobilePushExpoAccessToken}` } : {}),
+      },
+      body: JSON.stringify(body),
+    });
+    // Keep the deadline active until the body is consumed, not just until headers arrive.
+    if (response.status === 429 || response.status >= 500) throw new PushProviderError(`PUSH_PROVIDER_HTTP_${response.status}`, true);
+    let payload;
+    try { payload = await response.json(); } catch (error) {
+      if (controller.signal.aborted) throw error;
+      payload = null;
+    }
+    if (!response.ok || !payload || !("data" in payload)) {
+      const code = providerCode(payload?.errors?.[0]?.code, `HTTP_${response.status}`);
+      throw new PushProviderError(`PUSH_PROVIDER_${code}`.slice(0, 50), false);
+    }
+    return payload.data;
+  } catch (error) {
+    if (error instanceof PushProviderError) throw error;
+    // A timeout may happen after Expo accepted the batch, so it is not retried (no duplicate alerts).
+    const timedOut = controller.signal.aborted || error?.name === "AbortError" || error?.name === "TimeoutError";
+    throw new PushProviderError(timedOut ? "PUSH_PROVIDER_TIMEOUT" : "PUSH_PROVIDER_UNREACHABLE", !timedOut);
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+export async function sendExpoPushMessages(messages, { fetchImpl = fetch } = {}) {
+  if (messages.length > EXPO_MAX_MESSAGES) throw new RangeError("Expo accepts at most 100 messages per request.");
+  const tickets = await post(SEND_URL, messages, fetchImpl);
+  if (!Array.isArray(tickets) || tickets.length !== messages.length) {
+    throw new PushProviderError("PUSH_PROVIDER_INVALID_RESPONSE", false);
+  }
+  return tickets.map((ticket) => ticket?.status === "ok" && typeof ticket.id === "string"
+    ? { ok: true, ticketId: ticket.id.slice(0, 100) }
+    : { ok: false, errorCode: providerCode(ticket?.details?.error, "PushTicketError") });
+}
+
+export async function getExpoPushReceipts(ticketIds, { fetchImpl = fetch } = {}) {
+  if (ticketIds.length > EXPO_MAX_RECEIPTS) throw new RangeError("Expo accepts at most 1000 receipt IDs per request.");
+  const data = await post(RECEIPTS_URL, { ids: ticketIds }, fetchImpl);
+  const receipts = new Map();
+  for (const id of ticketIds) {
+    const receipt = data?.[id];
+    if (!receipt) continue;
+    receipts.set(id, receipt.status === "ok"
+      ? { ok: true }
+      : { ok: false, errorCode: providerCode(receipt.details?.error, "PushReceiptError") });
+  }
+  return receipts;
+}
diff --git a/src/modules/mobile/mobilePush.service.js b/src/modules/mobile/mobilePush.service.js
new file mode 100644
index 0000000..c8fafc9
--- /dev/null
+++ b/src/modules/mobile/mobilePush.service.js
@@ -0,0 +1,129 @@
+import { createCipheriv, createDecipheriv, createHmac, randomBytes, randomUUID } from "node:crypto";
+import prisma from "../../lib/prisma.js";
+import { env } from "../../config/env.js";
+import { AppError } from "../../utils/AppError.js";
+import { lockMobileSession } from "./mobile.service.js";
+
+export const MOBILE_PUSH_CHANNEL_ID = "account-updates";
+
+export function mobilePushConfigured() {
+  return env.mobilePushMode === "EXPO" && Boolean(env.mobileAuthSecret)
+    && /^[0-9a-fA-F]{64}$/.test(env.fieldEncryptionKey ?? "");
+}
+
+function requirePush() {
+  if (!mobilePushConfigured()) {
+    throw new AppError(503, "PUSH_UNAVAILABLE", "Phone alerts are not configured on this server. In-app notifications remain available.");
+  }
+}
+
+// The keyed hash finds a physical device without storing or comparing the raw provider token.
+function tokenHash(token) {
+  return createHmac("sha256", env.mobileAuthSecret).update(`mobile-push-token:${token}`).digest("hex");
+}
+
+function tokenKey() {
+  return Buffer.from(env.fieldEncryptionKey, "hex");
+}
+
+export function encryptPushToken(token, deviceId) {
+  const iv = randomBytes(12);
+  const cipher = createCipheriv("aes-256-gcm", tokenKey(), iv);
+  cipher.setAAD(Buffer.from(`mobile-push-device:${deviceId}`));
+  const ciphertext = Buffer.concat([cipher.update(token, "utf8"), cipher.final()]);
+  return [iv, cipher.getAuthTag(), ciphertext].map((part) => part.toString("base64url")).join(".");
+}
+
+export function decryptPushToken(value, deviceId) {
+  const [iv, tag, ciphertext] = String(value).split(".").map((part) => Buffer.from(part, "base64url"));
+  const decipher = createDecipheriv("aes-256-gcm", tokenKey(), iv);
+  decipher.setAAD(Buffer.from(`mobile-push-device:${deviceId}`));
+  decipher.setAuthTag(tag);
+  return Buffer.concat([decipher.update(ciphertext), decipher.final()]).toString("utf8");
+}
+
+// Never includes the token, its hash, or another session's details.
+function publicDevice(device) {
+  const status = !mobilePushConfigured() ? "unavailable" : !device ? "off" : device.disabledAt ? "invalid" : "on";
+  return {
+    configured: mobilePushConfigured(),
+    status,
+    enabled: status === "on",
+    language: device?.language ?? null,
+    updatedAt: device?.updatedAt?.toISOString() ?? null,
+  };
+}
+
+const deviceSelect = { deviceId: true, language: true, disabledAt: true, updatedAt: true };
+
+async function audit(database, beneficiaryId, action) {
+  await database.auditLog.create({ data: {
+    actorType: "BENEFICIARY", action, entityAffected: "BENEFICIARY", recordId: beneficiaryId,
+    details: { source: "MOBILE_APP", platform: "android" },
+  } });
+}
+
+export async function getMobilePushDevice(session) {
+  const device = await prisma.beneficiaryMobilePushDevice.findUnique({ where: { sessionId: session.sessionId }, select: deviceSelect });
+  return publicDevice(device);
+}
+
+export async function registerMobilePushDevice(session, { token, platform, language }) {
+  requirePush();
+  const hash = tokenHash(token);
+  try {
+    return await prisma.$transaction(async (tx) => {
+      const account = await lockMobileSession(tx, session);
+      // One owner per physical device: moving the token here stops delivery to its previous session or account.
+      const previous = await tx.beneficiaryMobilePushDevice.findUnique({
+        where: { tokenHash: hash }, select: { deviceId: true, sessionId: true, account: { select: { beneficiaryId: true } } },
+      });
+      if (previous && previous.sessionId !== session.sessionId) {
+        await tx.beneficiaryMobilePushDevice.delete({ where: { deviceId: previous.deviceId } });
+        if (previous.account.beneficiaryId !== account.beneficiaryId) await audit(tx, previous.account.beneficiaryId, "MOBILE_PUSH_DEVICE_REASSIGNED");
+      }
+      const current = await tx.beneficiaryMobilePushDevice.findUnique({ where: { sessionId: session.sessionId }, select: { deviceId: true } });
+      const deviceId = current?.deviceId ?? randomUUID();
+      const data = { registrationId: randomUUID(), tokenHash: hash, tokenCiphertext: encryptPushToken(token, deviceId), platform, language, disabledAt: null, disabledReason: null };
+      const device = current
+        ? await tx.beneficiaryMobilePushDevice.update({ where: { deviceId }, data, select: deviceSelect })
+        : await tx.beneficiaryMobilePushDevice.create({ data: { deviceId, accountId: account.accountId, sessionId: session.sessionId, ...data }, select: deviceSelect });
+      await audit(tx, account.beneficiaryId, "MOBILE_PUSH_DEVICE_REGISTERED");
+      return publicDevice(device);
+    });
+  } catch (error) {
+    // Two sessions registering the same device at once: the loser retries against the saved owner.
+    if (error.code === "P2002") throw new AppError(409, "PUSH_DEVICE_CHANGED", "This phone's alert registration changed. Try again.");
+    throw error;
+  }
+}
+
+export async function removeMobilePushDevice(session) {
+  return prisma.$transaction(async (tx) => {
+    const account = await lockMobileSession(tx, session);
+    const removed = await tx.beneficiaryMobilePushDevice.deleteMany({ where: { sessionId: session.sessionId } });
+    if (removed.count) await audit(tx, account.beneficiaryId, "MOBILE_PUSH_DEVICE_REMOVED");
+    return publicDevice(null);
+  });
+}
+
+// Runs inside the staff transaction: only database rows are written here. The dispatcher sends
+// after commit, so a rolled-back staff action never produces a phone alert.
+export async function queueMobilePushDeliveries(database, notifications, now = new Date()) {
+  if (!mobilePushConfigured() || !notifications.length) return 0;
+  const beneficiaryIds = [...new Set(notifications.map((row) => row.beneficiaryId))];
+  const devices = await database.beneficiaryMobilePushDevice.findMany({
+    where: {
+      disabledAt: null,
+      account: { beneficiaryId: { in: beneficiaryIds }, verifiedAt: { not: null } },
+      session: { revokedAt: null, expiresAt: { gt: now }, authMode: env.mobileAuthMode },
+    },
+    select: { deviceId: true, account: { select: { beneficiaryId: true } } },
+  });
+  const data = notifications.flatMap((notification) => devices
+    .filter((device) => device.account.beneficiaryId === notification.beneficiaryId)
+    .map((device) => ({ notificationId: notification.notificationId, deviceId: device.deviceId, nextAttemptAt: now })));
+  if (!data.length) return 0;
+  // The (notification, device) unique key prevents duplicate alerts from staff retries and replays.
+  return (await database.beneficiaryMobilePushDelivery.createMany({ data, skipDuplicates: true })).count;
+}
