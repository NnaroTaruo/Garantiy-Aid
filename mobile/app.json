{
  "expo": {
    "name": "GarantiyAid",
    "slug": "garantiyaid-mobile",
    "scheme": "garantiyaid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "ph.garantiyaid.mobile",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F8FAFC",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow GarantiyAid to capture your face after you give consent.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#155596",
          "defaultChannel": "account-updates"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e10780ef-4c52-48ff-ad6e-1b3db08d8e36"
      }
    },
    "owner": "ronan24"
  }
}
