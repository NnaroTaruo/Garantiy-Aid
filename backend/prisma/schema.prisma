generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Barangay {
  barangayId   String        @id @default(uuid()) @map("barangay_id") @db.Uuid
  barangayCode String        @unique @map("barangay_code") @db.VarChar(32)
  barangayName String        @map("barangay_name") @db.VarChar(120)
  city         String        @db.VarChar(120)
  province     String        @db.VarChar(120)
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  beneficiaries Beneficiary[]

  @@map("barangays")
}

model Beneficiary {
  beneficiaryId String         @id @default(uuid()) @map("beneficiary_id") @db.Uuid
  firstName     String         @map("first_name") @db.VarChar(100)
  middleName    String?        @map("middle_name") @db.VarChar(100)
  lastName      String         @map("last_name") @db.VarChar(100)
  birthDate     DateTime       @map("birth_date") @db.Date
  sex           String         @db.VarChar(32)
  address       String         @db.Text
  barangayId    String         @map("barangay_id") @db.Uuid
  contactNumber String         @unique @map("contact_number") @db.VarChar(20)
  email         String?        @unique @db.VarChar(254)
  passwordHash  String?        @map("password_hash") @db.VarChar(255)
  isVerified    Boolean        @default(false) @map("is_verified")
  philsysNumber String?        @unique @map("philsys_number") @db.VarChar(32)
  status        String         @default("pending") @db.VarChar(32)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  barangay      Barangay       @relation(fields: [barangayId], references: [barangayId])
  otpChallenges OtpChallenge[]
  authSessions  AuthSession[]
  enrollments   Enrollment[]
  schedules     Schedule[]
  qrTokens      QrToken[]
  claims        Claim[]
  walletAccount WalletAccount?
  transactions  Transaction[]
  notifications Notification[]

  @@index([barangayId])
  @@map("beneficiaries")
}

model Program {
  programId   String         @id @default(uuid()) @map("program_id") @db.Uuid
  programName String         @map("program_name") @db.VarChar(160)
  programCode String         @unique @map("program_code") @db.VarChar(32)
  programType String         @map("program_type") @db.VarChar(80)
  description String?        @db.Text
  grantAmount Decimal        @map("grant_amount") @db.Decimal(12, 2)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  enrollments Enrollment[]
  distributions Distribution[]

  @@map("programs")
}

model Enrollment {
  enrollmentId   String      @id @default(uuid()) @map("enrollment_id") @db.Uuid
  beneficiaryId  String      @map("beneficiary_id") @db.Uuid
  programId      String      @map("program_id") @db.Uuid
  enrollmentDate DateTime    @default(now()) @map("enrollment_date") @db.Date
  status         String      @default("pending") @db.VarChar(32)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary    Beneficiary @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)
  program        Program     @relation(fields: [programId], references: [programId])

  @@unique([beneficiaryId, programId])
  @@index([programId, status])
  @@map("enrollments")
}

model Distribution {
  distributionId   String     @id @default(uuid()) @map("distribution_id") @db.Uuid
  programId         String     @map("program_id") @db.Uuid
  title             String     @db.VarChar(160)
  distributionDate  DateTime   @map("distribution_date") @db.Date
  location          String     @db.VarChar(255)
  status            String     @default("scheduled") @db.VarChar(32)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  program           Program    @relation(fields: [programId], references: [programId])
  schedules         Schedule[]
  qrTokens          QrToken[]
  claims            Claim[]

  @@unique([programId, distributionDate, location])
  @@index([distributionDate, status])
  @@map("distributions")
}

model Schedule {
  scheduleId     String       @id @default(uuid()) @map("schedule_id") @db.Uuid
  distributionId String       @map("distribution_id") @db.Uuid
  beneficiaryId  String       @map("beneficiary_id") @db.Uuid
  slotStart       DateTime     @map("slot_start") @db.Timestamptz(6)
  slotEnd         DateTime     @map("slot_end") @db.Timestamptz(6)
  queueNumber     Int          @map("queue_number")
  status          String       @default("scheduled") @db.VarChar(32)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  distribution    Distribution @relation(fields: [distributionId], references: [distributionId], onDelete: Cascade)
  beneficiary     Beneficiary  @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)
  claim           Claim?
  notifications   Notification[]

  @@unique([distributionId, beneficiaryId])
  @@unique([distributionId, queueNumber])
  @@index([beneficiaryId, slotStart])
  @@map("schedules")
}

model QrToken {
  qrTokenId     String       @id @default(uuid()) @map("qr_token_id") @db.Uuid
  beneficiaryId String       @map("beneficiary_id") @db.Uuid
  distributionId String      @map("distribution_id") @db.Uuid
  tokenHash     String       @unique @map("token_hash") @db.Char(64)
  qrStatus      String       @default("active") @map("qr_status") @db.VarChar(32)
  expiresAt     DateTime     @map("expires_at") @db.Timestamptz(6)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary   Beneficiary  @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)
  distribution  Distribution @relation(fields: [distributionId], references: [distributionId], onDelete: Cascade)

  @@index([beneficiaryId, distributionId, qrStatus])
  @@map("qr_tokens")
}

model Claim {
  claimId             String       @id @default(uuid()) @map("claim_id") @db.Uuid
  beneficiaryId       String       @map("beneficiary_id") @db.Uuid
  distributionId      String       @map("distribution_id") @db.Uuid
  scheduleId          String       @unique @map("schedule_id") @db.Uuid
  claimStatus         String       @default("pending") @map("claim_status") @db.VarChar(32)
  verificationMethod  String?      @map("verification_method") @db.VarChar(32)
  biometricVerified   Boolean      @default(false) @map("biometric_verified")
  biometricScore      Decimal?     @map("biometric_score") @db.Decimal(5, 4)
  qrVerified          Boolean      @default(false) @map("qr_verified")
  isDuplicateFlag     Boolean      @default(false) @map("is_duplicate_flag")
  claimedAt           DateTime?    @map("claimed_at") @db.Timestamptz(6)
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary         Beneficiary  @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)
  distribution        Distribution @relation(fields: [distributionId], references: [distributionId])
  schedule            Schedule     @relation(fields: [scheduleId], references: [scheduleId])
  transaction         Transaction?

  @@unique([beneficiaryId, distributionId])
  @@index([beneficiaryId, claimStatus, createdAt])
  @@map("claims")
}

model WalletAccount {
  walletId          String        @id @default(uuid()) @map("wallet_id") @db.Uuid
  beneficiaryId     String        @unique @map("beneficiary_id") @db.Uuid
  balance           Decimal       @default(0) @db.Decimal(12, 2)
  currency          String        @default("PHP") @db.Char(3)
  accountStatus     String        @default("active") @map("account_status") @db.VarChar(32)
  lastTransactionAt DateTime?     @map("last_transaction_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary       Beneficiary   @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)
  transactions      Transaction[]

  @@map("wallet_accounts")
}

model Transaction {
  transactionId   String        @id @default(uuid()) @map("transaction_id") @db.Uuid
  claimId         String        @unique @map("claim_id") @db.Uuid
  walletId        String        @map("wallet_id") @db.Uuid
  beneficiaryId   String        @map("beneficiary_id") @db.Uuid
  amount          Decimal       @db.Decimal(12, 2)
  transactionType String        @map("transaction_type") @db.VarChar(32)
  referenceNo     String        @unique @map("reference_no") @db.VarChar(64)
  status          String        @default("posted") @db.VarChar(32)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  claim           Claim         @relation(fields: [claimId], references: [claimId])
  wallet          WalletAccount @relation(fields: [walletId], references: [walletId], onDelete: Cascade)
  beneficiary     Beneficiary   @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@index([beneficiaryId, createdAt])
  @@map("transactions")
}

model Notification {
  notificationId   String      @id @default(uuid()) @map("notification_id") @db.Uuid
  beneficiaryId    String      @map("beneficiary_id") @db.Uuid
  scheduleId       String?     @map("schedule_id") @db.Uuid
  channel          String      @default("in_app") @db.VarChar(32)
  title            String      @db.VarChar(160)
  titleBs          String?     @map("title_bs") @db.VarChar(160)
  message          String      @db.Text
  messageBs        String?     @map("message_bs") @db.Text
  notificationType String      @map("notification_type") @db.VarChar(32)
  status           String      @default("sent") @db.VarChar(32)
  sentAt           DateTime    @default(now()) @map("sent_at") @db.Timestamptz(6)
  readAt           DateTime?   @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary      Beneficiary @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)
  schedule         Schedule?   @relation(fields: [scheduleId], references: [scheduleId], onDelete: SetNull)

  @@index([beneficiaryId, createdAt])
  @@map("notifications")
}

model OtpChallenge {
  challengeId      String      @id @default(uuid()) @map("challenge_id") @db.Uuid
  beneficiaryId    String      @map("beneficiary_id") @db.Uuid
  purpose          String      @db.VarChar(20)
  codeHash         String      @map("code_hash") @db.Char(64)
  attemptsRemaining Int        @default(5) @map("attempts_remaining")
  expiresAt        DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt       DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary      Beneficiary @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)

  @@index([beneficiaryId, purpose, createdAt])
  @@map("otp_challenges")
}

model AuthSession {
  sessionId     String      @id @default(uuid()) @map("session_id") @db.Uuid
  beneficiaryId String      @map("beneficiary_id") @db.Uuid
  tokenHash     String      @unique @map("token_hash") @db.Char(64)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [beneficiaryId], onDelete: Cascade)

  @@index([beneficiaryId, expiresAt])
  @@map("auth_sessions")
}
